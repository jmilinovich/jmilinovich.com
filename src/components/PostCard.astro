---
import { fmtDate } from '../lib/process';

interface Props {
  title: string;
  date: string;
  slug: string;
  // A detail of the essay's own fingerprint. Computed by the caller, which holds
  // the post body; see detailFromBody in lib/process.
  glyph: string;
}

const { title, date, slug, glyph } = Astro.props;
---

<li class="row">
  <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><path d={glyph} /></svg>
  <a href={`/writing/${slug}`} class="row-title">{title}</a>
  <time class="row-date" datetime={date}>{fmtDate(date)}</time>
</li>

<style>
  .row {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    padding: 0.55rem 0;
  }

  .glyph {
    width: 20px;
    height: 20px;
    flex: none;
    align-self: center;
  }

  .row-title {
    font-family: 'Source Serif 4', Georgia, serif;
    font-size: 1.7rem;
    color: var(--ink-strong);
    line-height: 1.4;
  }

  .row-date {
    font-family: 'Berkeley Mono', monospace;
    font-size: 1.2rem;
    color: var(--muted);
    margin-left: auto;
    flex: none;
    padding-left: 1.2rem;
  }

  @media (max-width: 767px) {
    .row {
      flex-wrap: wrap;
      padding: 0.8rem 0;
    }
    .row-title {
      width: calc(100% - 20px - 1.2rem);
    }
    .row-date {
      margin-left: calc(20px + 1.2rem);
      padding-left: 0;
    }
  }
</style>
