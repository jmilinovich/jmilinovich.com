---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import KeepReading from '../../components/KeepReading.astro';
import { detailPath, fmtDate, essayFeatures, growthFoldSvg, detailFromBody } from '../../lib/process';
import { kinship } from '../../lib/kinship';

export async function getStaticPaths() {
  // Astro isolates getStaticPaths, so this lives here rather than at module scope.
  const ONWARD = 3;
  const posts = await getCollection('writing', ({ data }) => !data.draft);

  // Unlisted essays are vectorised (they get a foot like everyone else) but are
  // never anyone's neighbour — they're deliberately off every listing.
  const linkable = new Set(posts.filter((p) => !p.data.unlisted).map((p) => p.id));
  const byId = new Map(posts.map((p) => [p.id, p]));
  const neighbours = kinship(
    posts.map((p) => ({ id: p.id, title: p.data.title, body: p.body || '' })),
    { linkable, count: ONWARD }
  );

  return posts.map((post) => {
    // Computed by default; `related:` in frontmatter wins where the contact
    // sheet showed computation losing (see DESIGN.md §the essay foot).
    const picks = (post.data.related ?? neighbours.get(post.id).map((n) => n.id))
      .filter((id) => id !== post.id)
      .slice(0, ONWARD);

    const onward = picks.map((id) => {
      const p = byId.get(id);
      // Fail loudly: a renamed slug must not silently drop an onward link.
      if (!p) throw new Error(`${post.id}: related slug "${id}" is not a published essay`);
      return { slug: p.id, title: p.data.title, date: p.data.date, glyph: detailFromBody(p.id, p.body || '') };
    });

    return { params: { slug: post.id }, props: { post, onward } };
  });
}

const { post, onward } = Astro.props;
const { Content } = await render(post);

// One organism per essay, shown twice. The byline pressmark opens with the
// detail — the most folded stretch of this essay's mature line; the fingerprint
// closes with the same line fully grown (see growEssayLine in lib/process).
const feats = essayFeatures(post.body || '');
const glyph = detailPath(post.id, feats);
const fingerprint = growthFoldSvg(post.id, feats, +(post.data.date || '2026').slice(0, 4));

// Auto-extract description from first paragraph of markdown
function extractDescription(body: string): string {
  const lines = body.split('\n');
  for (const line of lines) {
    const trimmed = line.trim();
    // Skip frontmatter, headings, images, empty lines, and HTML
    if (!trimmed || trimmed.startsWith('#') || trimmed.startsWith('!') || trimmed.startsWith('<') || trimmed.startsWith('---') || trimmed.startsWith('_')) continue;
    // Strip markdown links and formatting
    const plain = trimmed
      .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
      .replace(/[*_~`]/g, '')
      .trim();
    if (plain.length > 20) {
      return plain.length > 160 ? plain.slice(0, 157) + '...' : plain;
    }
  }
  return '';
}

const postDescription = extractDescription(post.body || '');
---

<BaseLayout title={post.data.title} description={postDescription || undefined} ogImage={`/og/${post.id}.png`} noindex={post.data.unlisted}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <p class="byline">
        <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><path d={glyph} /></svg>
        <time datetime={post.data.date}>{fmtDate(post.data.date)}</time>
      </p>
    </header>
    <div class="post-content">
      <Content />
    </div>
    <figure class="fingerprint" aria-hidden="true">
      <div class="frame" set:html={fingerprint} />
      <figcaption>{feats.words.toLocaleString()} words</figcaption>
    </figure>
    <KeepReading items={onward} />
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 3.6rem;
  }

  .post-title {
    font-size: clamp(2.8rem, 2.1rem + 1.4vw, 3.8rem);
    line-height: 1.15;
    margin-bottom: 1.4rem;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: 'Berkeley Mono', monospace;
    font-size: 1.2rem;
    color: var(--muted);
  }

  .byline .glyph {
    width: 20px;
    height: 20px;
    flex: none;
  }

  .fingerprint {
    margin-top: 5rem;
  }

  .fingerprint .frame {
    border: 1px solid var(--hairline);
  }

  .fingerprint figcaption {
    font-family: 'Berkeley Mono', monospace;
    font-size: 1.15rem;
    color: var(--muted);
    text-align: right;
    margin-top: 0.7rem;
    letter-spacing: 0.02em;
  }

  .post-content {
    font-size: 1.7rem;
    line-height: 1.65;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
  }

  /* Shiki ships hardcoded inline styles; the direction wants monochrome,
     tokenized code — machine voice, achromatic chrome. */
  .post-content :global(pre) {
    font-family: 'Berkeley Mono', monospace;
    background: var(--code-bg) !important;
    padding: 1.6rem 2rem;
    overflow-x: auto;
    line-height: 1.5;
    margin: 2rem 0;
    font-size: 1.35rem;
  }

  .post-content :global(pre span) {
    color: var(--ink) !important;
    background: none !important;
  }

  .post-content :global(code) {
    font-family: 'Berkeley Mono', monospace;
    background: var(--code-bg);
    padding: 0.2rem 0.4rem;
    font-size: 1.35rem;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .post-content :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--muted);
    text-underline-offset: 0.2em;
  }

  .post-content :global(a:hover) {
    text-decoration-color: var(--ink-strong);
  }

  .post-content :global(strong) {
    color: var(--ink-strong);
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--hairline);
    margin: 3.2rem 0;
  }

  .post-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .post-content :global(h2) {
    margin-top: 4rem;
    margin-bottom: 1rem;
  }

  .post-content :global(h3) {
    margin-top: 3.2rem;
    margin-bottom: 1rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 2.4rem;
  }

  .post-content :global(li) {
    margin-top: 0.6rem;
  }

  .post-content :global(blockquote) {
    border-left: 2px solid var(--hairline);
    padding-left: 1.8rem;
    margin: 2rem 0;
    color: var(--muted);
    font-style: italic;
  }
</style>
