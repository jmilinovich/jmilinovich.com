---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { detailFromBody } from '../../lib/process';
import { getCollection } from 'astro:content';

const posts = await getCollection('writing', ({ data }) => !data.draft && !data.unlisted);
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="Writing - John Milinovich">
  <h1>Writing</h1>
  <section class="posts">
    <ul class="rows">
      {sortedPosts.map(post => (
        <PostCard title={post.data.title} date={post.data.date} slug={post.id} glyph={detailFromBody(post.id, post.body)} />
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 2rem;
  }

  .rows {
    list-style: none;
    padding: 0;
  }
</style>
