    </header>

    <main class="container">
      <h1>John Milinovich</h1>

      <figure class="instrument">
        <canvas id="field" height="136" aria-hidden="true"></canvas>
        <noscript set:html={noscriptFrame} />
        <figcaption>seed <span id="seed-date">{seedDate}</span>{fresh && ` · ${totalCommits.toLocaleString()} commits · 2022→26`}</figcaption>
      </figure>

      <ul class="facts">
        <li>Leading Generative AI Product at <a href="https://www.canva.com/">Canva</a>, where I helped build <a href="https://www.canva.com/newsroom/news/magic-studio/">Magic Studio</a> (<a href="https://time.com/7094550/canva-magic-studio/">Time's Best Inventions 2024</a>)</li>
        <li>Previously: founded <a href="https://techcrunch.com/2013/10/16/urx-ads/">URX</a> (acquired by Pinterest), led discovery at <a href="https://www.nytimes.com/2021/02/15/business/clubhouse.html">Clubhouse</a>, co-founded <a href="https://www.axios.com/2020/04/30/aesthetic-seed-funding-ai-brand-design">Aesthetic</a></li>
        <li>Early career at Google and Yahoo</li>
        <li>UCLA architecture — got hooked on code after seeing <a href="https://www.youtube.com/watch?v=_8DMEHxOLQE">Casey Reas</a> demo Processing.js</li>
        <li>Interested in AI-human collaboration, product craft, and building things</li>
      </ul>

      <section class="writing">
        <h2 class="eyebrow">Start here</h2>
        <ul class="rows">
          {startPicks.map((p) => (
            <li class="row">
              <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><path d={glyphs.get(p!.id)} /></svg>
              <a href={`/writing/${p!.id}`} class="row-title">{p!.data.title}</a>
              <time class="row-date" datetime={p!.data.date}>{fmtDate(p!.data.date)}</time>
            </li>
          ))}
        </ul>
      </section>

      <section class="writing">
        <h2 class="eyebrow">All writing</h2>
        <ul class="rows">
          {sorted.map((p) => (
            <li class="row">
              <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><path d={glyphs.get(p.id)} /></svg>
              <a href={`/writing/${p.id}`} class="row-title">{p.data.title}</a>
              <time class="row-date" datetime={p.data.date}>{fmtDate(p.data.date)}</time>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="site-footer">
      <a href="https://www.linkedin.com/in/johnmilinovich/">linkedin</a><span aria-hidden="true">·</span>
      <a href="https://x.com/jmilinovich">x</a><span aria-hidden="true">·</span>
      <a href="https://github.com/jmilinovich">github</a><span aria-hidden="true">·</span>
      <a href="/rss.xml">rss</a>
    </footer>

    <script define:vars={{ amplitude }}>
      // ---- the instrument: a settling field recording -------------------------
      // Contract (DESIGN.md §Motion): animates once on arrival, settles at a fixed
      // 840-step budget (identical drawing at any refresh rate), then the loop is
      // cancelled. Theme/resize/reduced-motion re-render the settled frame
      // synchronously. Pauses when hidden, resumes when visible.
      const canvas = document.getElementById('field');
      const ctx = canvas.getContext('2d');
      const reducedMq = window.matchMedia('(prefers-reduced-motion: reduce)');
      let reduced = reducedMq.matches;
      const DURATION = 7000;
      const STEPS_TOTAL = 840;
      const seed = new Date().toISOString().slice(0, 10); // client date → changes daily on a static build
      const seedEl = document.getElementById('seed-date');
      if (seedEl) seedEl.textContent = seed;
      let raf = 0, running = false, sim = null;

      function xmur3(str) {
        let h = 1779033703 ^ str.length;
        for (let i = 0; i < str.length; i++) {
          h = Math.imul(h ^ str.charCodeAt(i), 3432918353);
          h = (h << 13) | (h >>> 19);
        }
        return () => {
          h = Math.imul(h ^ (h >>> 16), 2246822507);
          h = Math.imul(h ^ (h >>> 13), 3266489909);
          return (h ^= h >>> 16) >>> 0;
        };
      }
      function mulberry32(a) {
        return () => {
          a |= 0; a = (a + 0x6d2b79f5) | 0;
          let t = Math.imul(a ^ (a >>> 15), 1 | a);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }
      function makeNoise(seedInt) {
        const lattice = (ix, iy) => {
          let h = Math.imul(ix, 374761393) + Math.imul(iy, 668265263) + Math.imul(seedInt, 2246822519);
          h = Math.imul(h ^ (h >>> 13), 1274126177);
          return (((h ^ (h >>> 16)) >>> 0) % 100000) / 100000;
        };
        const smooth = (t) => t * t * (3 - 2 * t);
        return (x, y) => {
          const ix = Math.floor(x), iy = Math.floor(y);
          const fx = smooth(x - ix), fy = smooth(y - iy);
          const a = lattice(ix, iy), b = lattice(ix + 1, iy);
          const c = lattice(ix, iy + 1), d = lattice(ix + 1, iy + 1);
          return a + (b - a) * fx + (c + (d - c) * fx - (a + (b - a) * fx)) * fy;
        };
      }

      function build() {
        const w = canvas.clientWidth || 575, h = canvas.clientHeight || 136;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);
        const dark = document.documentElement.getAttribute('data-theme') === 'dark';
        ctx.globalCompositeOperation = dark ? 'lighter' : 'source-over';
        const seedInt = xmur3(seed)();
        const rand = mulberry32(seedInt);
        const noise = makeNoise(seedInt);
        const P = 480;
        const parts = [];
        for (let i = 0; i < P; i++) {
          parts.push({ x: rand() * w, y: h * 0.12 + rand() * h * 0.76, life: 40 + rand() * 160 });
        }
        sim = {
          w, h, rand, noise, parts,
          color: dark ? '83,211,57' : '26,26,26',
          baseAlpha: dark ? 0.038 : 0.045,
          freq: 0.011,
          elapsed: 0,
          drawn: 0,
        };
      }

      function step(frames) {
        const { w, h, rand, noise, parts } = sim;
        ctx.lineWidth = 1;
        for (let f = 0; f < frames; f++) {
          ctx.beginPath();
          for (const p of parts) {
            const bpos = Math.max(0, Math.min(46.999, (p.x / w) * 47));
            const bi = Math.floor(bpos), bf = bpos - bi;
            const amp = amplitude[bi] * (1 - bf) + amplitude[bi + 1] * bf;
            const a = (noise(p.x * sim.freq, p.y * sim.freq * 2.2) - 0.5) * Math.PI * 2.6 * amp;
            const nx = p.x + Math.cos(a) * 1.05 + 0.4;
            const ny = p.y + Math.sin(a) * 1.05 * amp;
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(nx, ny);
            p.x = nx; p.y = ny;
            if (--p.life < 0 || p.x > w + 2 || p.y < -2 || p.y > h + 2) {
              p.x = rand() * w;
              p.y = h * 0.12 + rand() * h * 0.76;
              p.life = 40 + rand() * 160;
            }
          }
          ctx.strokeStyle = `rgba(${sim.color},${sim.baseAlpha})`;
          ctx.stroke();
        }
      }

      function pause() { running = false; cancelAnimationFrame(raf); }

      function runLoop() {
        if (running) return;
        running = true;
        let last = performance.now();
        const loop = (now) => {
          if (!running) return;
          const dt = Math.min(now - last, 100); // clamp: background-tab gaps must not expire the budget
          last = now;
          sim.elapsed += dt;
          const target = Math.min(STEPS_TOTAL, Math.round((sim.elapsed / DURATION) * STEPS_TOTAL));
          if (target > sim.drawn) { step(target - sim.drawn); sim.drawn = target; }
          if (sim.drawn >= STEPS_TOTAL) { running = false; return; } // settled — loop cancelled
          raf = requestAnimationFrame(loop);
        };
        raf = requestAnimationFrame(loop);
      }

      function start() {
        pause(); build();
        if (reduced) { settleNow(); return; }
        runLoop();
      }
      function settleNow() {
        step(STEPS_TOTAL - sim.drawn);
        sim.drawn = STEPS_TOTAL;
        sim.elapsed = DURATION;
      }
      function renderSettled() { pause(); build(); settleNow(); }
      function resume() {
        if (sim && sim.drawn < STEPS_TOTAL && !reduced) runLoop();
      }

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) pause();
        else resume();
      });
      new MutationObserver(() => renderSettled())
        .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      let rt;
      window.addEventListener('resize', () => {
        clearTimeout(rt);
        rt = setTimeout(() => { if (!sim || canvas.clientWidth !== sim.w) renderSettled(); }, 200);
      });
      reducedMq.addEventListener('change', (e) => {
        reduced = e.matches;
        if (reduced) renderSettled();
      });
      start();

      const toggle = document.getElementById('theme-toggle');
      const syncPressed = () =>
        toggle.setAttribute('aria-pressed', String(document.documentElement.getAttribute('data-theme') === 'dark'));
      syncPressed();
      toggle.addEventListener('click', () => {
        const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        syncPressed();
      });
    </script>

    <style is:global>
      :root {
        --paper: #fff;
        --ink: #333;
        --ink-strong: #111;
        --muted: #666;
        --hairline: #e6e6e6;
        --code-bg: #f5f5f5;
        --sig: #1a7f37;           /* moss — the light-mode voice of the system */
        --glyph: rgba(26, 26, 26, 0.85); /* plotter ink */
      }
      [data-theme='dark'] {
        --paper: #0a0a0a;
        --ink: #c8c8c8;
        --ink-strong: #e8e8e8;
        --muted: #8a8a8a;
        --hairline: #222;
        --code-bg: #1a1a1a;
        --sig: #53d339;           /* phosphor — off GitHub's swatch, onto the CRT */
        --glyph: #53d339;
      }
      /* no-JS: honor the OS scheme (JS sets data-theme before paint when present) */
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme]) {
          --paper: #0a0a0a;
          --ink: #c8c8c8;
          --ink-strong: #e8e8e8;
          --muted: #8a8a8a;
          --hairline: #222;
          --code-bg: #1a1a1a;
          --sig: #53d339;
          --glyph: #53d339;
        }
      }

      @font-face {
        font-family: 'Source Serif 4';
        src: url('/fonts/source-serif/ss4-latin-400-normal.woff2') format('woff2');
        font-weight: 400; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'Source Serif 4';
        src: url('/fonts/source-serif/ss4-latin-600-normal.woff2') format('woff2');
        font-weight: 600; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'Source Serif 4';
        src: url('/fonts/source-serif/ss4-latin-400-italic.woff2') format('woff2');
        font-weight: 400; font-style: italic; font-display: swap;
      }
      @font-face {
        font-family: 'Berkeley Mono';
        src: url('/fonts/BerkeleyMono-Regular.otf') format('opentype');
        font-weight: 400; font-style: normal; font-display: swap;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-size: 62.5%; scrollbar-gutter: stable; }
      body {
        font-family: 'Source Serif 4', Georgia, serif;
        font-size: 1.7rem;
        line-height: 1.65;
        color: var(--ink);
        background: var(--paper);
        -webkit-font-smoothing: antialiased;
      }
      ::selection { background: var(--sig); color: var(--paper); }
      a { color: inherit; text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
      :focus-visible { outline: 2px solid var(--sig); outline-offset: 3px; border-radius: 1px; }

      .site-header {
        max-width: 575px; margin: 0 auto; padding: 3rem 2rem 2.4rem;
        display: flex; align-items: center; justify-content: space-between;
      }
      nav { display: flex; gap: 1.8rem; align-items: center; }
      nav a, #theme-toggle {
        font-family: 'Berkeley Mono', monospace; font-size: 1.3rem; color: var(--muted);
        padding: 1.4rem 0.5rem; margin: -1.4rem -0.5rem; /* ≥44px touch targets, unchanged optics */
      }
      nav a:hover { color: var(--ink-strong); text-decoration: none; }
      #theme-toggle { background: none; border: none; cursor: pointer; font-size: 1.4rem; }
      .logo { display: flex; align-items: center; color: var(--ink-strong); padding: 0.8rem; margin: -0.8rem; }
      .logo:hover { text-decoration: none; opacity: 0.7; }
      .logo .logo-container { width: 42px; height: 28px; }

      .container { max-width: 575px; margin: 0 auto; padding: 0 2rem 6rem; }

      h1 {
        font-family: 'Source Serif 4', Georgia, serif;
        font-weight: 600;
        font-size: clamp(3rem, 2.2rem + 1.6vw, 4.2rem);
        letter-spacing: -0.015em;
        line-height: 1.1;
        color: var(--ink-strong);
        margin-bottom: 2rem;
      }

      .instrument { margin-bottom: 3.2rem; }
      .instrument canvas {
        display: block; width: 100%; height: 136px;
        border: 1px solid var(--hairline);
      }
      .instrument noscript svg { border: 1px solid var(--hairline); }
      .instrument figcaption {
        font-family: 'Berkeley Mono', monospace;
        font-size: 1.15rem; color: var(--muted);
        text-align: right; margin-top: 0.7rem; letter-spacing: 0.02em;
      }

      .facts { list-style: disc; padding-left: 2rem; margin-bottom: 4rem; }
      .facts li { margin-bottom: 0.7rem; }
      .facts a { text-decoration: underline; text-decoration-color: var(--muted); text-underline-offset: 0.2em; }
      .facts a:hover { text-decoration-color: var(--ink-strong); }

      .eyebrow {
        font-family: 'Berkeley Mono', monospace;
        font-size: 1.2rem; font-weight: 400;
        color: var(--muted);
        text-transform: uppercase; letter-spacing: 0.12em;
        margin-bottom: 1.6rem;
      }

