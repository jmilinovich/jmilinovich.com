---
// Design proof — instrument v4: the substrate. Decided 2026-07-28 via /grill-me.
// The page is the petri dish: a curtain of roots descends from the top edge,
// parting around every text block (text is stone), taproot-thick primaries
// ramifying into hairline rootlets, fed by commit density with no time axis.
// Arrival grows the first viewport; scroll grows the rest; everything settles.
// Provenance waits at the bottom of the soil. Homepage untouched until this
// proof is approved.
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import contributions from '../../public/data/contributions.json';

const posts = await getCollection('writing', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const seedDate = new Date().toISOString().slice(0, 10);
const days = (contributions as { date: string; count: number }[])
  .slice()
  .sort((a, b) => a.date.localeCompare(b.date));
const totalCommits = days.reduce((s, d) => s + d.count, 0);
const lastDataDate = days[days.length - 1]?.date ?? '1970-01-01';
const fresh = Math.floor((Date.parse(seedDate) - Date.parse(lastDataDate)) / 86400000) <= 30;
const countsB36 = days.map((d) => Math.min(35, d.count).toString(36)).join('');

const starts = [
  'the-agentic-web',
  'dangerously-good-product-managers',
  'less-is-more-the-art-of-sculpting-products',
  'just-do-things',
];
const startPicks = starts.map((s) => sortedPosts.find((p) => p.id === s)).filter(Boolean);
---

<BaseLayout title="John Milinovich — design proof">
  <div class="substrate" id="substrate" aria-hidden="true" data-counts={countsB36}>
    <canvas id="s-dot" width="72" height="72"></canvas>
  </div>

  <h1>John Milinovich</h1>

  <ul class="facts">
    <li>Led Generative AI Product at <a href="https://www.canva.com/">Canva</a>, where I helped build <a href="https://www.canva.com/newsroom/news/magic-studio/">Magic Studio</a> (<a href="https://time.com/7094550/canva-magic-studio/">Time's Best Inventions 2024</a>) and <a href="https://www.canva.com/newsroom/news/canva-create-2025/">Canva AI</a></li>
    <li>Previously: founded <a href="https://techcrunch.com/2013/10/16/urx-ads/">URX</a> (acquired by Pinterest), led discovery at <a href="https://www.nytimes.com/2021/02/15/business/clubhouse.html">Clubhouse</a>, co-founded <a href="https://www.axios.com/2020/04/30/aesthetic-seed-funding-ai-brand-design">Aesthetic</a></li>
    <li>Early career at Google and Yahoo</li>
    <li>UCLA architecture &mdash; got hooked on code after seeing <a href="https://www.youtube.com/watch?v=_8DMEHxOLQE">Casey Reas</a> demo Processing.js</li>
    <li>Interested in AI-human collaboration, product craft, and building things</li>
  </ul>

  <section class="writing-section">
    <h2 class="eyebrow">Start here</h2>
    <ul class="rows">
      {startPicks.map(post => (
        <PostCard title={post!.data.title} date={post!.data.date} slug={post!.id} />
      ))}
    </ul>
  </section>

  <section class="writing-section">
    <h2 class="eyebrow">All writing</h2>
    <ul class="rows">
      {sortedPosts.map(post => (
        <PostCard title={post.data.title} date={post.data.date} slug={post.id} />
      ))}
    </ul>
  </section>

  <figure class="provenance">
    <figcaption>seed <span id="p-seed">&hellip;</span>{fresh && ` · ${totalCommits.toLocaleString()} commits`}</figcaption>
  </figure>
</BaseLayout>

<script>
  // Instrument v4 — the substrate. A curtain of roots descends from the top
  // edge of the document, in page coordinates, behind the content. Text
  // blocks are stones: growth senses their rects and flows around them.
  // Geometry is iteration-based and fully precomputed per seed — time and
  // scroll only pace the reveal, so the finished organism is identical at
  // any refresh rate. Arrival grows the first viewport once (~7s); after
  // that, growth advances only while the reader scrolls (idle CPU ~0), and
  // every region settles to rest. New random seed per load; the provenance
  // line at the bottom of the soil shows it, and ?seed=<hex> replays one.
  // Lifecycle-safe under the ClientRouter.
  const ARRIVE_MS = 7000;
  const STEP = 2.0;
  const SLICE = 2048;           // css px per canvas slice (Safari-safe backing sizes)
  const CAP = 120;              // max concurrent tips
  const AREA_BUDGET = 42e6;     // device px across all slices; dpr degrades past it

  const reducedMq = window.matchMedia('(prefers-reduced-motion: reduce)');
  let reduced = reducedMq.matches;
  let host: HTMLElement | null = null;
  let dotCv: HTMLCanvasElement | null = null;
  let slices: { cv: HTMLCanvasElement; ctx: CanvasRenderingContext2D; top: number }[] = [];
  let raf = 0, running = false, starting = false;
  let art: any = null;

  function mulberry32(a: number) {
    return () => {
      a |= 0; a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function makeNoise(seedInt: number) {
    const lattice = (ix: number, iy: number) => {
      let h = Math.imul(ix, 374761393) + Math.imul(iy, 668265263) + Math.imul(seedInt, 2246822519);
      h = Math.imul(h ^ (h >>> 13), 1274126177);
      return (((h ^ (h >>> 16)) >>> 0) % 100000) / 100000;
    };
    const sm = (t: number) => t * t * (3 - 2 * t);
    return (x: number, y: number) => {
      const ix = Math.floor(x), iy = Math.floor(y);
      const fx = sm(x - ix), fy = sm(y - iy);
      const a = lattice(ix, iy), b = lattice(ix + 1, iy);
      const c = lattice(ix, iy + 1), d = lattice(ix + 1, iy + 1);
      return a + (b - a) * fx + (c + (d - c) * fx - (a + (b - a) * fx)) * fy;
    };
  }

  function colors() {
    const s = getComputedStyle(document.documentElement);
    return {
      glyph: s.getPropertyValue('--glyph').trim() || 'rgba(26,26,26,0.85)',
      sig: s.getPropertyValue('--sig').trim() || '#1a7f37',
      dark: document.documentElement.getAttribute('data-theme') === 'dark',
    };
  }

  // Text is stone: padded rects growth must flow around. Header links, the
  // h1, the facts, whole writing sections, the provenance line, the footer.
  function measureStones(w: number) {
    const px = w < 480 ? 7 : 12, py = w < 480 ? 6 : 9;
    const sy = window.scrollY;
    const stones: { x0: number; y0: number; x1: number; y1: number; cx: number }[] = [];
    document.querySelectorAll('header a, header button, main h1, main .facts, main .writing-section, main .provenance, footer .footer-inner').forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.width < 2 || r.height < 2) return;
      stones.push({ x0: r.left - px, y0: r.top + sy - py, x1: r.right + px, y1: r.bottom + sy + py, cx: (r.left + r.right) / 2 });
    });
    return stones;
  }

  // Commits as nutrients, no axis: every day's work is scattered through the
  // soil at seed-chosen positions; roots ramify and thicken where the mass
  // landed. Total vigor is the year's total work.
  function buildField(counts: number[], seedInt: number, w: number, h: number) {
    const cell = 56;
    const gw = Math.max(2, Math.ceil(w / cell)), gh = Math.max(2, Math.ceil(h / cell));
    const grid = new Float32Array(gw * gh);
    const f = mulberry32((seedInt ^ 0x9e3779b9) | 0);
    for (const c of counts) {
      const gx = f() * (gw - 1), gy = f() * (gh - 1);
      if (!c) continue;
      const m = Math.log1p(c);
      const ix = Math.round(gx), iy = Math.round(gy);
      for (let dy = -2; dy <= 2; dy++) {
        for (let dx = -2; dx <= 2; dx++) {
          const jx = ix + dx, jy = iy + dy;
          if (jx < 0 || jx >= gw || jy < 0 || jy >= gh) continue;
          grid[jy * gw + jx] += m * Math.exp(-(dx * dx + dy * dy) / 2.4);
        }
      }
    }
    const sorted = Array.from(grid).sort((a, b) => a - b);
    const p95 = Math.max(sorted[Math.floor(sorted.length * 0.95)] || 0, 0.001);
    for (let i = 0; i < grid.length; i++) grid[i] = Math.min(1.25, grid[i] / p95);
    return (x: number, y: number) => {
      const fx = Math.max(0, Math.min(gw - 1.001, x / cell)), fy = Math.max(0, Math.min(gh - 1.001, y / cell));
      const ix = Math.floor(fx), iy = Math.floor(fy);
      const tx = fx - ix, ty = fy - iy;
      const a = grid[iy * gw + ix], b = grid[iy * gw + ix + 1];
      const c = grid[(iy + 1) * gw + ix], d = grid[(iy + 1) * gw + ix + 1];
      return a + (b - a) * tx + (c + (d - c) * tx - (a + (b - a) * tx)) * ty;
    };
  }

  function makeSlices(w: number, h: number) {
    if (!host) return;
    for (const s of slices) s.cv.remove();
    slices = [];
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    if (w * h * dpr * dpr > AREA_BUDGET) dpr = Math.max(1, Math.sqrt(AREA_BUDGET / (w * h)));
    const n = Math.ceil(h / SLICE);
    for (let i = 0; i < n; i++) {
      const top = i * SLICE, ch = Math.min(SLICE, h - top);
      const cv = document.createElement('canvas');
      cv.width = Math.round(w * dpr);
      cv.height = Math.round(ch * dpr);
      cv.style.cssText = `position:absolute;left:0;top:${top}px;width:${w}px;height:${ch}px;display:block;`;
      const ctx = cv.getContext('2d')!;
      ctx.setTransform(dpr, 0, 0, dpr, 0, -top * dpr);
      host.insertBefore(cv, dotCv);
      slices.push({ cv, ctx, top });
    }
  }

  // Precompute the whole organism for this seed. Angles are deviations from
  // straight down; wander stays within a downward cone, but avoidance may
  // open to near-horizontal (never sustained upward) so roots can trace
  // along a stone's face and resume their dive past its edge.
  const DEVS = [0.18, 0.38, 0.62, 0.9, 1.2, 1.45, 1.72];
  function build(keepSeed = false) {
    if (!host) return;
    const params = new URLSearchParams(location.search);
    let seedInt: number;
    if (keepSeed && art) seedInt = art.seedInt;
    else if (params.get('seed')) seedInt = parseInt(params.get('seed')!, 16) | 0;
    else seedInt = (Math.random() * 2 ** 32) | 0;
    const label = document.getElementById('p-seed');
    if (label) label.textContent = (seedInt >>> 0).toString(16).padStart(8, '0');

    const w = document.documentElement.clientWidth;
    host.style.height = '0px';
    const h = Math.max(document.documentElement.scrollHeight, window.innerHeight);
    host.style.height = h + 'px';
    makeSlices(w, h);
    const stones = measureStones(w);
    const counts = [...((host.dataset.counts as string) || '')].map((c) => parseInt(c, 36));
    const fieldAt = buildField(counts, seedInt, w, h);

    const rand = mulberry32(seedInt);
    const noise = makeNoise(seedInt);
    const blocked = (x: number, y: number, pad = 0) => {
      if (x < 2 || x > w - 2) return true;
      for (const s of stones) if (x > s.x0 - pad && x < s.x1 + pad && y > s.y0 - pad && y < s.y1 + pad) return true;
      return false;
    };

    type Tip = { x: number; y: number; dev: number; wd: number; tier: number; born: number; alive: boolean; pad: number; age: number; maxAge: number; slide: number; stall: number };
    const nP = Math.max(5, Math.min(16, Math.round(w / 120)));
    const tips: Tip[] = [];
    for (let i = 0; i < nP; i++) {
      // drop each origin into a gap between header stones so the curtain
      // doesn't scribble along the nav; in thin soil (narrow viewports) also
      // steer origins clear of the column corridor — the gutters are the
      // only ground that goes anywhere
      const deepCheck = w < 900;
      let ox = w * (0.03 + (0.94 * (i + 0.15 + rand() * 0.7)) / nP);
      for (let tries = 0; tries < 12 && (blocked(ox, 26, 4) || blocked(ox, 54, 4) || (deepCheck && blocked(ox, 110, 3))); tries++) {
        ox = w * (0.02 + rand() * 0.96);
      }
      tips.push({
        x: ox,
        y: -3,
        dev: (rand() - 0.5) * 0.2,
        wd: 2.2 + rand() * 0.9,
        tier: 0,
        born: Math.round(rand() * 220),
        alive: true,
        pad: rand() * (w < 700 ? 4 : 9),
        age: 0,
        maxAge: 1e9,
        slide: 0,
        stall: 0,
      });
    }
    let total = tips.length;
    let far = { x: w / 2, y: 0 };
    const iters: number[][][] = [];
    const frontier: number[] = [];
    const deepX: number[] = [], deepY: number[] = [];
    const maxIter = Math.ceil((h / STEP) * 2.4) + 400;
    for (let it = 0; it < maxIter; it++) {
      const segs: number[][] = [];
      let anyAlive = false;
      const spawned: Tip[] = [];
      for (const t of tips) {
        if (!t.alive || t.born > it) { if (t.alive) anyAlive = true; continue; }
        anyAlive = true;
        t.age++;
        if (t.age > t.maxAge) { t.alive = false; continue; } // rootlets are short-lived; taproots persist
        const e = fieldAt(t.x, t.y);
        // near-straight descent with fine tremor and occasional decisive
        // kinks — root tropism, not flow-field smoke
        t.dev += (noise(t.x * 0.02, t.y * 0.02 + t.tier * 7) - 0.5) * (0.1 + e * 0.16);
        if (rand() < 0.018) t.dev += (rand() < 0.5 ? -1 : 1) * (0.18 + rand() * 0.35);
        t.dev *= 0.955;
        const lim = t.tier === 0 ? 0.5 : t.tier === 1 ? 0.85 : 1.05;
        t.dev = Math.max(-1.75, Math.min(1.75, t.dev));
        if (Math.abs(t.dev) <= lim) t.dev = Math.max(-lim, Math.min(lim, t.dev));
        let nx = t.x + Math.sin(t.dev) * STEP, ny = t.y + Math.cos(t.dev) * STEP;
        if (blocked(nx, ny, t.pad)) {
          // steer around the stone: prefer the side away from its center;
          // sliding along a face carries a mortality tax so traces stay
          // organic mats, not drawn rectangles — much steeper against the
          // little header stones, which must not grow whiskers
          t.slide = 10;
          let hit: any = null;
          for (const s of stones) if (nx > s.x0 - t.pad && nx < s.x1 + t.pad && ny > s.y0 - t.pad && ny < s.y1 + t.pad) { hit = s; break; }
          if (rand() < (hit && hit.y1 < 70 ? 0.3 : 0.0015)) { t.alive = false; continue; }
          const pref = hit && t.x >= hit.cx ? 1 : -1;
          let found = false;
          for (const d of DEVS) {
            for (const sgn of [pref, -pref]) {
              const dv = Math.max(-1.75, Math.min(1.75, t.dev + sgn * d));
              const cx = t.x + Math.sin(dv) * STEP, cy = t.y + Math.cos(dv) * STEP;
              if (!blocked(cx, cy, t.pad)) { t.dev = dv; nx = cx; ny = cy; found = true; break; }
            }
            if (found) break;
          }
          // truly cornered: stall and let the noise shift before giving up —
          // pinch-points between wall and stone are passes, not graves
          if (!found) { if (++t.stall > 50) t.alive = false; continue; }
          t.stall = 0;
          // following a wall down is nearly free; crawling sideways across a
          // stone's face is fatal — kills the traced-border artifact without
          // starving the gutters
          if (Math.abs(t.dev) > 1.2 && rand() < 0.022) { t.alive = false; continue; }
        } else if (t.slide > 0) {
          t.slide--;
          if (rand() < 0.0015) { t.alive = false; continue; }
        }
        segs.push([t.x, t.y, nx, ny, t.wd]);
        t.x = nx; t.y = ny;
        if (t.y > far.y) far = { x: t.x, y: t.y };
        if (t.y > h - 10) { t.alive = false; continue; } // bottom of the soil
        t.wd *= t.tier === 0 ? 0.99985 : 0.9994;
        if (t.wd > 0.6 && total < CAP && rand() < (0.004 + e * 0.03 * rand())) {
          spawned.push({
            x: t.x, y: t.y,
            dev: t.dev + (rand() < 0.5 ? -1 : 1) * (0.3 + rand() * 0.45),
            wd: Math.max(0.5, t.wd * 0.58),
            tier: t.tier + 1,
            born: it + 1,
            alive: true,
            pad: rand() * (w < 700 ? 4 : 9),
            age: 0,
            maxAge: t.tier === 0 ? 260 + rand() * 520 : 90 + rand() * 240,
            slide: 0,
            stall: 0,
          });
          total++;
        }
      }
      tips.push(...spawned);
      iters.push(segs);
      frontier.push(far.y);
      deepX.push(far.x); deepY.push(Math.min(far.y, h - 12));
      if (!anyAlive) break;
    }
    art = {
      seedInt, iters, frontier, deepX, deepY, w, h,
      drawn: 0, target: 0, phase: 'arrive', elapsed: 0, arriveIt: 0, acc: 0, chaseRate: 0.12,
    };
    (window as any).__dbg = { art, nSegs: iters.reduce((s: number, a: any[]) => s + a.length, 0), drawCalls: 0, get isRunning() { return running; } };
  }

  function itFor(depth: number) {
    if (!art) return 0;
    const f = art.frontier;
    let lo = 0, hi = f.length;
    while (lo < hi) { const mid = (lo + hi) >> 1; if (f[mid] < depth) lo = mid + 1; else hi = mid; }
    return Math.min(f.length, lo + 1);
  }

  function drawRange(from: number, to: number) {
    if ((window as any).__dbg) (window as any).__dbg.drawCalls++;
    if (!art || !slices.length) return;
    const c = colors();
    for (const s of slices) { s.ctx.strokeStyle = c.glyph; s.ctx.lineCap = 'round'; }
    const nS = slices.length;
    for (let it = from; it < to; it++) {
      for (const [x1, y1, x2, y2, wd] of art.iters[it]) {
        const a = 0.14 + Math.min(0.6, wd * 0.26);
        const s1 = Math.max(0, (y1 / SLICE) | 0), s2 = Math.max(0, (y2 / SLICE) | 0);
        for (let si = s1; si <= s2 && si < nS; si++) {
          const ctx = slices[si].ctx;
          ctx.globalAlpha = a;
          ctx.lineWidth = wd;
          ctx.beginPath();
          ctx.moveTo(x1, y1);
          ctx.lineTo(x2, y2);
          ctx.stroke();
        }
      }
    }
    for (const s of slices) s.ctx.globalAlpha = 1;
  }

  function placeDot() {
    if (!art || !dotCv) return;
    const i = Math.max(0, Math.min(art.drawn, art.deepX.length) - 1);
    const x = art.deepX[i], y = art.deepY[i];
    dotCv.style.transform = `translate(${(x - 18).toFixed(1)}px, ${(y - 18).toFixed(1)}px)`;
    const ctx = dotCv.getContext('2d')!;
    const c = colors();
    ctx.setTransform(2, 0, 0, 2, 0, 0);
    ctx.clearRect(0, 0, 36, 36);
    ctx.fillStyle = c.sig;
    if (c.dark) {
      ctx.globalAlpha = 0.22;
      ctx.beginPath(); ctx.arc(18, 18, 8, 0, Math.PI * 2); ctx.fill();
      ctx.globalAlpha = 1;
    }
    ctx.beginPath(); ctx.arc(18, 18, 3.2, 0, Math.PI * 2); ctx.fill();
  }

  const ease = (t: number) => (t < 0 ? 0 : t > 1 ? 1 : t * t * (3 - 2 * t));

  function pause() { running = false; cancelAnimationFrame(raf); }

  function kick() {
    if (running || !art || art.drawn >= art.target) return;
    running = true;
    let last = performance.now();
    const loop = (now: number) => {
      if (!running || !art) return;
      const dt = Math.min(now - last, 100);
      last = now;
      let tgt = art.drawn;
      if (art.phase === 'arrive') {
        art.elapsed += dt;
        tgt = Math.min(art.target, Math.round(ease(art.elapsed / ARRIVE_MS) * art.arriveIt));
        if (art.elapsed >= ARRIVE_MS) art.phase = 'chase';
      } else {
        art.acc += dt * art.chaseRate;
        const adv = Math.floor(art.acc);
        art.acc -= adv;
        tgt = Math.min(art.target, art.drawn + adv);
      }
      if (tgt > art.drawn) { drawRange(art.drawn, tgt); art.drawn = tgt; placeDot(); }
      if (art.drawn >= art.target && art.phase !== 'arrive') { running = false; return; } // settled
      if (art.drawn >= art.iters.length) { running = false; return; }
      raf = requestAnimationFrame(loop);
    };
    raf = requestAnimationFrame(loop);
  }

  // Scroll is the only input: the reveal target follows the reader down,
  // with a lead of most of a viewport so growth stays ahead of the eye.
  function onScroll() {
    if (!art || reduced) return;
    const ni = itFor(window.scrollY + window.innerHeight * 1.7);
    if (ni > art.target) { art.target = Math.min(ni, art.iters.length); kick(); }
  }

  function renderSettled(keepSeed = true) {
    if (!host) return;
    pause(); build(keepSeed);
    if (!art) return;
    art.arriveIt = itFor(window.innerHeight * 1.15);
    const upTo = reduced ? art.iters.length : Math.max(art.arriveIt, itFor(window.scrollY + window.innerHeight * 1.7));
    art.drawn = art.target = Math.min(upTo, art.iters.length);
    art.phase = 'chase';
    art.elapsed = ARRIVE_MS;
    drawRange(0, art.drawn);
    placeDot();
  }

  function start() {
    if (!host) return;
    pause(); build();
    if (!art) return;
    art.arriveIt = itFor(window.innerHeight * 1.15);
    art.chaseRate = Math.max(0.1, (art.arriveIt / ARRIVE_MS) * 3.5);
    if (reduced) { renderSettled(); return; }
    art.target = Math.max(art.arriveIt, itFor(window.scrollY + window.innerHeight * 1.7));
    kick();
  }

  function teardown() {
    pause();
    art = null; host = null; dotCv = null; slices = []; starting = false;
  }

  function init() {
    const el = document.getElementById('substrate');
    if (!el) { teardown(); return; }
    if (el === host && art) return;
    host = el;
    dotCv = document.getElementById('s-dot') as HTMLCanvasElement | null;
    if (starting) return;
    starting = true;
    // measure stones only after the real faces are in — a fallback timer
    // covers browsers where fonts.ready stalls
    Promise.race([(document as any).fonts?.ready ?? Promise.resolve(), new Promise((r) => setTimeout(r, 700))]).then(() => {
      starting = false;
      if (host && document.getElementById('substrate') === host) start();
    });
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', teardown);
  document.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('visibilitychange', () => {
    if (!art) return;
    if (document.hidden) pause();
    else kick();
  });
  new MutationObserver(() => {
    if (!art) return;
    for (const s of slices) { const d = s.cv.width; s.ctx.save(); s.ctx.setTransform(1, 0, 0, 1, 0, 0); s.ctx.clearRect(0, 0, d, s.cv.height); s.ctx.restore(); }
    drawRange(0, art.drawn);
    placeDot();
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  let rt: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(rt);
    rt = setTimeout(() => {
      if (!host || !art) return;
      const w = document.documentElement.clientWidth;
      host.style.height = '0px';
      const h = Math.max(document.documentElement.scrollHeight, window.innerHeight);
      host.style.height = art.h + 'px';
      if (w !== art.w || Math.abs(h - art.h) > 4) renderSettled(true);
    }, 200);
  });
  reducedMq.addEventListener('change', (e) => {
    reduced = e.matches;
    if (reduced && art) renderSettled(true);
  });
  init();
</script>

