---
// DESIGN PROOF — direction "Process". Standalone page, does not touch the live app.
// One generative system, two materials: phosphor (dark) / plotter ink (light).
import { getCollection } from 'astro:content';
import Logo from '../components/Logo.astro';
import contributions from '../../public/data/contributions.json';

const posts = await getCollection('writing', ({ data }) => !data.draft);
const sorted = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });

// ---- deterministic PRNG -----------------------------------------------------
function xmur3(str: string) {
  let h = 1779033703 ^ str.length;
  for (let i = 0; i < str.length; i++) {
    h = Math.imul(h ^ str.charCodeAt(i), 3432918353);
    h = (h << 13) | (h >>> 19);
  }
  return () => {
    h = Math.imul(h ^ (h >>> 16), 2246822507);
    h = Math.imul(h ^ (h >>> 13), 3266489909);
    return (h ^= h >>> 16) >>> 0;
  };
}
function mulberry32(a: number) {
  return () => {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
// value noise on a hashed lattice — no arrays, fully deterministic per seed
function makeNoise(seedInt: number) {
  const lattice = (ix: number, iy: number) => {
    let h = Math.imul(ix, 374761393) + Math.imul(iy, 668265263) + Math.imul(seedInt, 2246822519);
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return (((h ^ (h >>> 16)) >>> 0) % 100000) / 100000;
  };
  const smooth = (t: number) => t * t * (3 - 2 * t);
  return (x: number, y: number) => {
    const ix = Math.floor(x), iy = Math.floor(y);
    const fx = smooth(x - ix), fy = smooth(y - iy);
    const a = lattice(ix, iy), b = lattice(ix + 1, iy);
    const c = lattice(ix, iy + 1), d = lattice(ix + 1, iy + 1);
    return a + (b - a) * fx + (c + (d - c) * fx - (a + (b - a) * fx)) * fy;
  };
}

// ---- build-time glyphs: one streamline per essay, seeded by its slug --------
function glyphPath(slug: string): string {
  const seedInt = xmur3(slug)();
  const rand = mulberry32(seedInt);
  const noise = makeNoise(seedInt);
  const freq = 0.055 + rand() * 0.05;
  const turb = 1.7 + rand() * 1.1;
  const S = 40, STEPS = 84;
  let best: { pts: [number, number][]; span: number } = { pts: [], span: 0 };
  for (let c = 0; c < 8; c++) {
    let x = 6 + rand() * (S - 12), y = 6 + rand() * (S - 12);
    const pts: [number, number][] = [[x, y]];
    let minX = x, maxX = x, minY = y, maxY = y;
    for (let i = 0; i < STEPS; i++) {
      const a = (noise(x * freq, y * freq) - 0.5) * Math.PI * 2 * turb;
      x += Math.cos(a) * 0.85;
      y += Math.sin(a) * 0.85;
      if (x < 1 || x > S - 1 || y < 1 || y > S - 1) break;
      pts.push([x, y]);
      minX = Math.min(minX, x); maxX = Math.max(maxX, x);
      minY = Math.min(minY, y); maxY = Math.max(maxY, y);
    }
    const span = (maxX - minX) * (maxY - minY) + pts.length;
    if (span > best.span) best = { pts, span };
  }
  const pts = best.pts;
  if (pts.length < 4) return 'M6 12 L18 12';
  // normalize into a 24×24 viewBox with 3px padding
  let minX = 1e9, maxX = -1e9, minY = 1e9, maxY = -1e9;
  for (const [px, py] of pts) {
    minX = Math.min(minX, px); maxX = Math.max(maxX, px);
    minY = Math.min(minY, py); maxY = Math.max(maxY, py);
  }
  const scale = 18 / Math.max(maxX - minX, maxY - minY, 1);
  const ox = 3 + (18 - (maxX - minX) * scale) / 2, oy = 3 + (18 - (maxY - minY) * scale) / 2;
  return pts
    .map(([px, py], i) =>
      `${i === 0 ? 'M' : 'L'}${((px - minX) * scale + ox).toFixed(1)} ${((py - minY) * scale + oy).toFixed(1)}`)
    .join('');
}
const glyphs = new Map(sorted.map((p) => [p.id, glyphPath(p.id)]));

// ---- commit history → 48 amplitude buckets, behind the 30-day freshness guard
const days = (contributions as { date: string; count: number }[]).slice();
days.sort((a, b) => a.date.localeCompare(b.date));
const seedDate = new Date().toISOString().slice(0, 10); // build-time fallback; client re-seeds daily
const lastDataDate = days[days.length - 1]?.date ?? '1970-01-01';
const dataAgeDays = Math.floor((Date.parse(seedDate) - Date.parse(lastDataDate)) / 86400000);
const fresh = dataAgeDays <= 30;
const B = 48;
let amplitude: number[];
if (fresh) {
  const buckets = new Array(B).fill(0);
  days.forEach((d, i) => { buckets[Math.min(B - 1, Math.floor((i / days.length) * B))] += d.count; });
  const maxB = Math.max(...buckets, 1);
  amplitude = buckets.map((v) => +(0.25 + 0.75 * Math.sqrt(v / maxB)).toFixed(3));
} else {
  amplitude = new Array(B).fill(1); // stale data → pure date-seed field (DESIGN.md freshness guard)
}
const totalCommits = days.reduce((s, d) => s + d.count, 0);

// ---- no-JS fallback: the settled frame rendered at build as inline SVG ------
function settledFrameSvg(seed: string): string {
  const W = 575, H = 136;
  const rand = mulberry32(xmur3(seed)());
  const noise = makeNoise(xmur3(seed)());
  const lines: string[] = [];
  for (let i = 0; i < 80; i++) {
    let x = rand() * W, y = H * 0.12 + rand() * H * 0.76;
    const pts: string[] = [`${x.toFixed(0)},${y.toFixed(0)}`];
    for (let s = 0; s < 55; s++) {
      const bpos = Math.max(0, Math.min(46.999, (x / W) * 47));
      const bi = Math.floor(bpos), bf = bpos - bi;
      const amp = amplitude[bi] * (1 - bf) + amplitude[bi + 1] * bf;
      const a = (noise(x * 0.011, y * 0.011 * 2.2) - 0.5) * Math.PI * 2.6 * amp;
      x += Math.cos(a) * 2.1 + 0.8;
      y += Math.sin(a) * 2.1 * amp;
      if (x > W + 2 || y < -2 || y > H + 2) break;
      pts.push(`${x.toFixed(0)},${y.toFixed(0)}`);
    }
    if (pts.length > 6) lines.push(`<polyline points="${pts.join(' ')}"/>`);
  }
  return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" style="display:block;width:100%;height:136px" fill="none" stroke="var(--glyph)" stroke-opacity="0.28" stroke-width="1">${lines.join('')}</svg>`;
}
const noscriptFrame = settledFrameSvg(seedDate);

const starts = [
  'the-agentic-web',
  'dangerously-good-product-managers',
  'the-courage-to-remove',
  'just-do-things',
];
const startPicks = starts.map((s) => sorted.find((p) => p.id === s)).filter(Boolean);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Design proof — Process</title>
    <meta name="robots" content="noindex" />
    <link rel="preload" href="/fonts/source-serif/ss4-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif/ss4-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/BerkeleyMono-Regular.otf" as="font" type="font/otf" crossorigin />
