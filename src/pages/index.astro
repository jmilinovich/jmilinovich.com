---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { buildWave, waveSvg } from '../lib/process';
import contributions from '../../public/data/contributions.json';

const posts = await getCollection('writing', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const seedDate = new Date().toISOString().slice(0, 10); // build-time fallback; the client re-seeds daily
const days = (contributions as { date: string; count: number }[])
  .slice()
  .sort((a, b) => a.date.localeCompare(b.date));
const totalCommits = days.reduce((s, d) => s + d.count, 0);
const lastDataDate = days[days.length - 1]?.date ?? '1970-01-01';
const fresh = Math.floor((Date.parse(seedDate) - Date.parse(lastDataDate)) / 86400000) <= 30;
// daily counts, capped at 35, one base36 char per day — the trace's raw material
const countsB36 = days.map((d) => Math.min(35, d.count).toString(36)).join('');
const noscriptFrame = waveSvg(days, seedDate);
const { ticks } = buildWave(days, seedDate);
const tickFracs = ticks.map((t) => +(((t.x - 6) / (575 - 12)).toFixed(4)));

const starts = [
  'the-agentic-web',
  'dangerously-good-product-managers',
  'less-is-more-the-art-of-sculpting-products', // "The courage to remove"
  'just-do-things',
];
const startPicks = starts.map((s) => sortedPosts.find((p) => p.id === s)).filter(Boolean);
---

<BaseLayout title="John Milinovich">
  <h1>John Milinovich</h1>

  <figure class="instrument">
    <canvas
      id="field"
      height="136"
      aria-hidden="true"
      data-counts={countsB36}
      data-ticks={JSON.stringify(tickFracs)}
    ></canvas>
    <noscript set:html={noscriptFrame} />
    <div class="year-axis" aria-hidden="true">
      {ticks.map((t) => (
        <span style={`left: ${((t.x / 575) * 100).toFixed(2)}%`}>{t.label}</span>
      ))}
    </div>
    <figcaption>seed <span id="seed-date">{seedDate}</span>{fresh && ` · ${totalCommits.toLocaleString()} commits`}</figcaption>
  </figure>

  <ul class="facts">
    <li>Led Generative AI Product at <a href="https://www.canva.com/">Canva</a>, where I helped build <a href="https://www.canva.com/newsroom/news/magic-studio/">Magic Studio</a> (<a href="https://time.com/7094550/canva-magic-studio/">Time's Best Inventions 2024</a>) and <a href="https://www.canva.com/newsroom/news/canva-create-2025/">Canva AI</a></li>
    <li>Previously: founded <a href="https://techcrunch.com/2013/10/16/urx-ads/">URX</a> (acquired by Pinterest), led discovery at <a href="https://www.nytimes.com/2021/02/15/business/clubhouse.html">Clubhouse</a>, co-founded <a href="https://www.axios.com/2020/04/30/aesthetic-seed-funding-ai-brand-design">Aesthetic</a></li>
    <li>Early career at Google and Yahoo</li>
    <li>UCLA architecture &mdash; got hooked on code after seeing <a href="https://www.youtube.com/watch?v=_8DMEHxOLQE">Casey Reas</a> demo Processing.js</li>
    <li>Interested in AI-human collaboration, product craft, and building things</li>
  </ul>

  <section class="writing-section">
    <h2 class="eyebrow">Start here</h2>
    <ul class="rows">
      {startPicks.map(post => (
        <PostCard title={post!.data.title} date={post!.data.date} slug={post!.id} />
      ))}
    </ul>
  </section>

  <section class="writing-section">
    <h2 class="eyebrow">All writing</h2>
    <ul class="rows">
      {sortedPosts.map(post => (
        <PostCard title={post.data.title} date={post.data.date} slug={post.id} />
      ))}
    </ul>
  </section>
</BaseLayout>

<script>
  // The instrument: a seismogram of the commit history, 2022 → today.
  // One continuous trace drawn once per arrival like a plotter pen (~6s),
  // then still. Calm weeks run flat; heavy weeks oscillate. The only colour
  // is the terminal dot: today. Geometry is precomputed, so the finished
  // drawing is identical at any refresh rate. Lifecycle-safe under the
  // ClientRouter: init on astro:page-load (guarded), teardown on before-swap.
  // KEEP THE WAVE MATH IN SYNC with buildWave in src/lib/process.js.
  const DRAW_MS = 6000;
  const reducedMq = window.matchMedia('(prefers-reduced-motion: reduce)');
  let reduced = reducedMq.matches;
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let raf = 0, running = false;
  let wave: any = null; // { pts, ticks, end, baseY, w, h, drawn, elapsed }

  function xmur3(str: string) {
    let h = 1779033703 ^ str.length;
    for (let i = 0; i < str.length; i++) {
      h = Math.imul(h ^ str.charCodeAt(i), 3432918353);
      h = (h << 13) | (h >>> 19);
    }
    return () => {
      h = Math.imul(h ^ (h >>> 16), 2246822507);
      h = Math.imul(h ^ (h >>> 13), 3266489909);
      return (h ^= h >>> 16) >>> 0;
    };
  }
  function mulberry32(a: number) {
    return () => {
      a |= 0; a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function makeNoise(seedInt: number) {
    const lattice = (ix: number, iy: number) => {
      let h = Math.imul(ix, 374761393) + Math.imul(iy, 668265263) + Math.imul(seedInt, 2246822519);
      h = Math.imul(h ^ (h >>> 13), 1274126177);
      return (((h ^ (h >>> 16)) >>> 0) % 100000) / 100000;
    };
    const smooth = (t: number) => t * t * (3 - 2 * t);
    return (x: number, y: number) => {
      const ix = Math.floor(x), iy = Math.floor(y);
      const fx = smooth(x - ix), fy = smooth(y - iy);
      const a = lattice(ix, iy), b = lattice(ix + 1, iy);
      const c = lattice(ix, iy + 1), d = lattice(ix + 1, iy + 1);
      return a + (b - a) * fx + (c + (d - c) * fx - (a + (b - a) * fx)) * fy;
    };
  }

  function colors() {
    const s = getComputedStyle(document.documentElement);
    return {
      ink: s.getPropertyValue('--ink').trim() || '#333',
      hairline: s.getPropertyValue('--hairline').trim() || '#e6e6e6',
      muted: s.getPropertyValue('--muted').trim() || '#666',
      sig: s.getPropertyValue('--sig').trim() || '#1a7f37',
      dark: document.documentElement.getAttribute('data-theme') === 'dark',
    };
  }

  function build() {
    if (!canvas || !ctx) return;
    const params = new URLSearchParams(location.search);
    const seed = params.get('seed') || new Date().toISOString().slice(0, 10);
    const seedEl = document.getElementById('seed-date');
    if (seedEl) seedEl.textContent = seed;
    const w = canvas.clientWidth || 575, h = canvas.clientHeight || 136;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const counts = [...(canvas.dataset.counts || '')].map((c) => parseInt(c, 36));
    const n = counts.length || 1;
    const raw = counts.map((c) => Math.log1p(c));
    const sortedRaw = raw.slice().sort((a, b) => a - b);
  const p95 = Math.max(sortedRaw[Math.floor(sortedRaw.length * 0.95)] || 0, 0.001);
    const env = raw.map((_, i) => {
      let s = 0, wt = 0;
      for (let k = -4; k <= 4; k++) {
        const j = i + k;
        if (j < 0 || j >= n) continue;
        const g = 1 - Math.abs(k) / 5;
        s += raw[j] * g; wt += g;
      }
      return Math.min(1.25, s / wt / p95);
    });
    const seedInt = xmur3(seed)();
    const rand = mulberry32(seedInt);
    const noise = makeNoise(seedInt);
    let phase = rand() * Math.PI * 2;
    const padX = 6, baseY = h * 0.52, span = w - padX * 2;
    const pts: [number, number][] = [];
    for (let x = 0; x <= span; x += 1) {
      const t = x / span;
      const di = Math.min(n - 1, Math.floor(t * n));
      const e = env[di];
      const amp = Math.pow(e, 1.12) * h * 0.36;
      phase += 0.18 + e * 1.1;
      const jitter = (noise(x * 0.035, 7.3) - 0.5) * 3.0 * (0.25 + e);
      pts.push([x + padX, baseY + Math.sin(phase) * amp + jitter]);
    }
    const ticks = JSON.parse(canvas.dataset.ticks || '[]').map((f: number) => padX + f * span);
    wave = { pts, ticks, end: pts[pts.length - 1], baseY, w, h, drawn: 0, elapsed: 0 };
  }

  function scaffold() {
    if (!ctx || !wave) return;
    const c = colors();
    ctx.clearRect(0, 0, wave.w, wave.h);
    ctx.strokeStyle = c.hairline;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(6, wave.baseY);
    ctx.lineTo(wave.w - 6, wave.baseY);
    ctx.stroke();
    ctx.strokeStyle = c.muted;
    ctx.globalAlpha = 0.55;
    ctx.beginPath();
    for (const x of wave.ticks) {
      ctx.moveTo(x, wave.baseY + 8);
      ctx.lineTo(x, wave.baseY + 14);
    }
    ctx.stroke();
    ctx.globalAlpha = 1;
  }

  function trace(from: number, to: number) {
    if (!ctx || !wave) return;
    const c = colors();
    ctx.strokeStyle = c.ink;
    ctx.globalAlpha = 0.72;
    ctx.lineWidth = 1.25;
    ctx.lineJoin = 'round';
    ctx.beginPath();
    const start = Math.max(0, from - 1);
    ctx.moveTo(wave.pts[start][0], wave.pts[start][1]);
    for (let i = start + 1; i <= to; i++) ctx.lineTo(wave.pts[i][0], wave.pts[i][1]);
    ctx.stroke();
    ctx.globalAlpha = 1;
  }

  function dot() {
    if (!ctx || !wave) return;
    const c = colors();
    const [x, y] = wave.end;
    if (c.dark) {
      ctx.fillStyle = c.sig;
      ctx.globalAlpha = 0.22;
      ctx.beginPath();
      ctx.arc(x, y, 7, 0, Math.PI * 2);
      ctx.fill();
      ctx.globalAlpha = 1;
    }
    ctx.fillStyle = c.sig;
    ctx.beginPath();
    ctx.arc(x, y, 3, 0, Math.PI * 2);
    ctx.fill();
  }

  function pause() { running = false; cancelAnimationFrame(raf); }

  function renderSettled() {
    if (!canvas) return;
    pause(); build(); scaffold();
    trace(0, wave.pts.length - 1);
    wave.drawn = wave.pts.length - 1;
    wave.elapsed = DRAW_MS;
    dot();
  }

  function runLoop() {
    if (running || !wave) return;
    running = true;
    let last = performance.now();
    const loop = (now: number) => {
      if (!running || !wave) return;
      const dt = Math.min(now - last, 100);
      last = now;
      wave.elapsed += dt;
      const target = Math.min(wave.pts.length - 1, Math.round((wave.elapsed / DRAW_MS) * (wave.pts.length - 1)));
      if (target > wave.drawn) { trace(wave.drawn, target); wave.drawn = target; }
      if (wave.drawn >= wave.pts.length - 1) { dot(); running = false; return; }
      raf = requestAnimationFrame(loop);
    };
    raf = requestAnimationFrame(loop);
  }

  function start() {
    pause(); build();
    if (!wave) return;
    scaffold();
    if (reduced) { renderSettled(); return; }
    runLoop();
  }

  function teardown() {
    pause();
    wave = null;
    canvas = null;
    ctx = null;
  }

  function init() {
    const el = document.getElementById('field') as HTMLCanvasElement | null;
    if (!el) { teardown(); return; }
    if (el === canvas && wave) return;
    canvas = el;
    ctx = el.getContext('2d');
    start();
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', teardown);
  document.addEventListener('visibilitychange', () => {
    if (!wave) return;
    if (document.hidden) pause();
    else if (wave.drawn < wave.pts.length - 1 && !reduced) runLoop();
  });
  new MutationObserver(() => { if (wave) renderSettled(); })
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  let rt: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(rt);
    rt = setTimeout(() => { if (canvas && wave && canvas.clientWidth !== wave.w) renderSettled(); }, 200);
  });
  reducedMq.addEventListener('change', (e) => {
    reduced = e.matches;
    if (reduced && wave) renderSettled();
  });
  init();
</script>

<style>
  h1 {
    margin-bottom: 2rem;
  }

  .instrument {
    margin-bottom: 3.2rem;
  }
  .instrument canvas {
    display: block;
    width: 100%;
    height: 136px;
    border: 1px solid var(--hairline);
  }
  .instrument :global(noscript svg) {
    border: 1px solid var(--hairline);
  }
  .year-axis {
    position: relative;
    height: 1.5rem;
    margin-top: 0.4rem;
    font-family: 'Berkeley Mono', monospace;
    font-size: 1.05rem;
    color: var(--muted);
  }

  .year-axis span {
    position: absolute;
    transform: translateX(-50%);
  }

  .instrument figcaption {
    font-family: 'Berkeley Mono', monospace;
    font-size: 1.15rem;
    color: var(--muted);
    text-align: right;
    margin-top: 0.2rem;
    letter-spacing: 0.02em;
  }

  .facts {
    list-style: disc;
    padding-left: 2rem;
    font-size: 1.7rem;
    line-height: 1.65;
    color: var(--ink);
    margin-bottom: 4rem;
  }

  .facts li {
    margin-bottom: 0.7rem;
  }

  .facts a {
    text-decoration: underline;
    text-decoration-color: var(--muted);
    text-underline-offset: 0.2em;
  }

  .facts a:hover {
    text-decoration-color: var(--ink-strong);
  }

  .writing-section {
    margin-bottom: 4rem;
  }

  .rows {
    list-style: none;
    padding: 0;
  }
</style>
