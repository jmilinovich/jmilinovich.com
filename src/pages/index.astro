---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { commitAmplitude, settledFrameSvg } from '../lib/process';
import contributions from '../../public/data/contributions.json';

const posts = await getCollection('writing', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const seedDate = new Date().toISOString().slice(0, 10); // build-time fallback; the client re-seeds daily
const { amplitude, fresh, totalCommits } = commitAmplitude(
  contributions as { date: string; count: number }[],
  seedDate,
);
const noscriptFrame = settledFrameSvg(seedDate, amplitude);

const starts = [
  'the-agentic-web',
  'dangerously-good-product-managers',
  'less-is-more-the-art-of-sculpting-products', // "The courage to remove"
  'just-do-things',
];
const startPicks = starts.map((s) => sortedPosts.find((p) => p.id === s)).filter(Boolean);
---

<BaseLayout title="John Milinovich">
  <h1>John Milinovich</h1>

  <figure class="instrument">
    <canvas
      id="field"
      height="136"
      aria-hidden="true"
      data-amplitude={JSON.stringify(amplitude)}
    ></canvas>
    <noscript set:html={noscriptFrame} />
    <figcaption>seed <span id="seed-date">{seedDate}</span>{fresh && ` · ${totalCommits.toLocaleString()} commits · 2022→26`}</figcaption>
  </figure>

  <ul class="facts">
    <li>Led Generative AI Product at <a href="https://www.canva.com/">Canva</a>, where I helped build <a href="https://www.canva.com/newsroom/news/magic-studio/">Magic Studio</a> (<a href="https://time.com/7094550/canva-magic-studio/">Time's Best Inventions 2024</a>) and <a href="https://www.canva.com/newsroom/news/canva-create-2025/">Canva AI</a></li>
    <li>Previously: founded <a href="https://techcrunch.com/2013/10/16/urx-ads/">URX</a> (acquired by Pinterest), led discovery at <a href="https://www.nytimes.com/2021/02/15/business/clubhouse.html">Clubhouse</a>, co-founded <a href="https://www.axios.com/2020/04/30/aesthetic-seed-funding-ai-brand-design">Aesthetic</a></li>
    <li>Early career at Google and Yahoo</li>
    <li>UCLA architecture &mdash; got hooked on code after seeing <a href="https://www.youtube.com/watch?v=_8DMEHxOLQE">Casey Reas</a> demo Processing.js</li>
    <li>Interested in AI-human collaboration, product craft, and building things</li>
  </ul>

  <section class="writing-section">
    <h2 class="eyebrow">Start here</h2>
    <ul class="rows">
      {startPicks.map(post => (
        <PostCard title={post!.data.title} date={post!.data.date} slug={post!.id} />
      ))}
    </ul>
  </section>

  <section class="writing-section">
    <h2 class="eyebrow">All writing</h2>
    <ul class="rows">
      {sortedPosts.map(post => (
        <PostCard title={post.data.title} date={post.data.date} slug={post.id} />
      ))}
    </ul>
  </section>
</BaseLayout>

<script>
  // The instrument — settling field recording. Contract in DESIGN.md §Motion:
  // animates once per arrival at a fixed 840-step budget (refresh-rate-proof),
  // then the loop is cancelled. Theme/resize/reduced-motion re-render the
  // settled frame synchronously. Pauses on hidden, resumes on visible.
  // Lifecycle-safe under the ClientRouter: init on astro:page-load (guarded),
  // teardown on astro:before-swap.
  const DURATION = 7000;
  const STEPS_TOTAL = 840;
  const reducedMq = window.matchMedia('(prefers-reduced-motion: reduce)');
  let reduced = reducedMq.matches;
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let amplitude: number[] = [];
  let raf = 0, running = false, sim: any = null;

  function xmur3(str: string) {
    let h = 1779033703 ^ str.length;
    for (let i = 0; i < str.length; i++) {
      h = Math.imul(h ^ str.charCodeAt(i), 3432918353);
      h = (h << 13) | (h >>> 19);
    }
    return () => {
      h = Math.imul(h ^ (h >>> 16), 2246822507);
      h = Math.imul(h ^ (h >>> 13), 3266489909);
      return (h ^= h >>> 16) >>> 0;
    };
  }
  function mulberry32(a: number) {
    return () => {
      a |= 0; a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function makeNoise(seedInt: number) {
    const lattice = (ix: number, iy: number) => {
      let h = Math.imul(ix, 374761393) + Math.imul(iy, 668265263) + Math.imul(seedInt, 2246822519);
      h = Math.imul(h ^ (h >>> 13), 1274126177);
      return (((h ^ (h >>> 16)) >>> 0) % 100000) / 100000;
    };
    const smooth = (t: number) => t * t * (3 - 2 * t);
    return (x: number, y: number) => {
      const ix = Math.floor(x), iy = Math.floor(y);
      const fx = smooth(x - ix), fy = smooth(y - iy);
      const a = lattice(ix, iy), b = lattice(ix + 1, iy);
      const c = lattice(ix, iy + 1), d = lattice(ix + 1, iy + 1);
      return a + (b - a) * fx + (c + (d - c) * fx - (a + (b - a) * fx)) * fy;
    };
  }

  function build() {
    if (!canvas || !ctx) return;
    const seed = new Date().toISOString().slice(0, 10);
    const seedEl = document.getElementById('seed-date');
    if (seedEl) seedEl.textContent = seed;
    const w = canvas.clientWidth || 575, h = canvas.clientHeight || 136;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    ctx.globalCompositeOperation = dark ? 'lighter' : 'source-over';
    const seedInt = xmur3(seed)();
    const rand = mulberry32(seedInt);
    const noise = makeNoise(seedInt);
    const parts = [];
    for (let i = 0; i < 480; i++) {
      parts.push({ x: rand() * w, y: h * 0.12 + rand() * h * 0.76, life: 40 + rand() * 160 });
    }
    sim = {
      w, h, rand, noise, parts,
      color: dark ? '83,211,57' : '26,26,26',
      baseAlpha: dark ? 0.038 : 0.045,
      freq: 0.011,
      elapsed: 0,
      drawn: 0,
    };
  }

  function step(frames: number) {
    if (!ctx) return;
    const { w, h, rand, noise, parts } = sim;
    ctx.lineWidth = 1;
    for (let f = 0; f < frames; f++) {
      ctx.beginPath();
      for (const p of parts) {
        const bpos = Math.max(0, Math.min(46.999, (p.x / w) * 47));
        const bi = Math.floor(bpos), bf = bpos - bi;
        const amp = amplitude[bi] * (1 - bf) + amplitude[bi + 1] * bf;
        const a = (noise(p.x * sim.freq, p.y * sim.freq * 2.2) - 0.5) * Math.PI * 2.6 * amp;
        const nx = p.x + Math.cos(a) * 1.05 + 0.4;
        const ny = p.y + Math.sin(a) * 1.05 * amp;
        ctx.moveTo(p.x, p.y);
        ctx.lineTo(nx, ny);
        p.x = nx; p.y = ny;
        if (--p.life < 0 || p.x > w + 2 || p.y < -2 || p.y > h + 2) {
          p.x = rand() * w;
          p.y = h * 0.12 + rand() * h * 0.76;
          p.life = 40 + rand() * 160;
        }
      }
      ctx.strokeStyle = `rgba(${sim.color},${sim.baseAlpha})`;
      ctx.stroke();
    }
  }

  function pause() { running = false; cancelAnimationFrame(raf); }

  function runLoop() {
    if (running) return;
    running = true;
    let last = performance.now();
    const loop = (now: number) => {
      if (!running || !sim) return;
      const dt = Math.min(now - last, 100); // clamp: background-tab gaps must not expire the budget
      last = now;
      sim.elapsed += dt;
      const target = Math.min(STEPS_TOTAL, Math.round((sim.elapsed / DURATION) * STEPS_TOTAL));
      if (target > sim.drawn) { step(target - sim.drawn); sim.drawn = target; }
      if (sim.drawn >= STEPS_TOTAL) { running = false; return; } // settled — loop cancelled
      raf = requestAnimationFrame(loop);
    };
    raf = requestAnimationFrame(loop);
  }

  function settleNow() {
    step(STEPS_TOTAL - sim.drawn);
    sim.drawn = STEPS_TOTAL;
    sim.elapsed = DURATION;
  }
  function renderSettled() { if (!canvas) return; pause(); build(); settleNow(); }
  function start() {
    pause(); build();
    if (reduced) { settleNow(); return; }
    runLoop();
  }
  function teardown() {
    pause();
    sim = null;
    canvas = null;
    ctx = null;
  }

  function init() {
    const el = document.getElementById('field') as HTMLCanvasElement | null;
    if (!el) { teardown(); return; }
    if (el === canvas && sim) return; // same page, already live
    canvas = el;
    ctx = el.getContext('2d');
    amplitude = JSON.parse(el.dataset.amplitude || '[]');
    start();
  }

  // Registered once at module scope; all handlers no-op when no canvas is live.
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', teardown);
  document.addEventListener('visibilitychange', () => {
    if (!sim) return;
    if (document.hidden) pause();
    else if (sim.drawn < STEPS_TOTAL && !reduced) runLoop();
  });
  new MutationObserver(() => { if (sim) renderSettled(); })
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  let rt: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(rt);
    rt = setTimeout(() => { if (canvas && sim && canvas.clientWidth !== sim.w) renderSettled(); }, 200);
  });
  reducedMq.addEventListener('change', (e) => {
    reduced = e.matches;
    if (reduced && sim) renderSettled();
  });
  init();
</script>

<style>
  h1 {
    margin-bottom: 2rem;
  }

  .instrument {
    margin-bottom: 3.2rem;
  }
  .instrument canvas {
    display: block;
    width: 100%;
    height: 136px;
    border: 1px solid var(--hairline);
  }
  .instrument :global(noscript svg) {
    border: 1px solid var(--hairline);
  }
  .instrument figcaption {
    font-family: 'Berkeley Mono', monospace;
    font-size: 1.15rem;
    color: var(--muted);
    text-align: right;
    margin-top: 0.7rem;
    letter-spacing: 0.02em;
  }

  .facts {
    list-style: disc;
    padding-left: 2rem;
    font-size: 1.7rem;
    line-height: 1.65;
    color: var(--ink);
    margin-bottom: 4rem;
  }

  .facts li {
    margin-bottom: 0.7rem;
  }

  .facts a {
    text-decoration: underline;
    text-decoration-color: var(--muted);
    text-underline-offset: 0.2em;
  }

  .facts a:hover {
    text-decoration-color: var(--ink-strong);
  }

  .writing-section {
    margin-bottom: 4rem;
  }

  .rows {
    list-style: none;
    padding: 0;
  }
</style>
