---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { buildRoots, rootsSvg, xmur3 } from '../lib/process';
import contributions from '../../public/data/contributions.json';

const posts = await getCollection('writing', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const seedDate = new Date().toISOString().slice(0, 10); // build-time fallback; the client re-seeds daily
const days = (contributions as { date: string; count: number }[])
  .slice()
  .sort((a, b) => a.date.localeCompare(b.date));
const totalCommits = days.reduce((s, d) => s + d.count, 0);
const lastDataDate = days[days.length - 1]?.date ?? '1970-01-01';
const fresh = Math.floor((Date.parse(seedDate) - Date.parse(lastDataDate)) / 86400000) <= 30;
// daily counts, capped at 35, one base36 char per day — the growth's raw material
const countsArr = days.map((d) => Math.min(35, d.count));
const countsB36 = countsArr.map((c) => c.toString(36)).join('');
const noscriptFrame = rootsSvg(countsArr, xmur3(seedDate)());

const starts = [
  'the-agentic-web',
  'dangerously-good-product-managers',
  'less-is-more-the-art-of-sculpting-products', // "The courage to remove"
  'just-do-things',
];
const startPicks = starts.map((s) => sortedPosts.find((p) => p.id === s)).filter(Boolean);
---

<BaseLayout title="John Milinovich">
  <h1>John Milinovich</h1>

  <figure class="instrument">
    <canvas
      id="field"
      height="136"
      aria-hidden="true"
      data-counts={countsB36}
    ></canvas>
    <noscript set:html={noscriptFrame} />
    <figcaption>seed <span id="seed-label">{seedDate}</span>{fresh && ` · ${totalCommits.toLocaleString()} commits`}</figcaption>
  </figure>

  <ul class="facts">
    <li>Led Generative AI Product at <a href="https://www.canva.com/">Canva</a>, where I helped build <a href="https://www.canva.com/newsroom/news/magic-studio/">Magic Studio</a> (<a href="https://time.com/7094550/canva-magic-studio/">Time's Best Inventions 2024</a>) and <a href="https://www.canva.com/newsroom/news/canva-create-2025/">Canva AI</a></li>
    <li>Previously: founded <a href="https://techcrunch.com/2013/10/16/urx-ads/">URX</a> (acquired by Pinterest), led discovery at <a href="https://www.nytimes.com/2021/02/15/business/clubhouse.html">Clubhouse</a>, co-founded <a href="https://www.axios.com/2020/04/30/aesthetic-seed-funding-ai-brand-design">Aesthetic</a></li>
    <li>Early career at Google and Yahoo</li>
    <li>UCLA architecture &mdash; got hooked on code after seeing <a href="https://www.youtube.com/watch?v=_8DMEHxOLQE">Casey Reas</a> demo Processing.js</li>
    <li>Interested in AI-human collaboration, product craft, and building things</li>
  </ul>

  <section class="writing-section">
    <h2 class="eyebrow">Start here</h2>
    <ul class="rows">
      {startPicks.map(post => (
        <PostCard title={post!.data.title} date={post!.data.date} slug={post!.id} />
      ))}
    </ul>
  </section>

  <section class="writing-section">
    <h2 class="eyebrow">All writing</h2>
    <ul class="rows">
      {sortedPosts.map(post => (
        <PostCard title={post.data.title} date={post.data.date} slug={post.id} />
      ))}
    </ul>
  </section>
</BaseLayout>

<script>
  // The instrument: rootwork. Branching growth, left to right across the
  // years — roots creep and ramify where the commit history is dense. A new
  // random seed every load; the caption shows it, and ?seed=<hex> replays
  // one. Grows once over ~5.6s (geometry is iteration-based, so the finished
  // drawing is identical at any refresh rate; time only paces it), then
  // still. The only colour is the terminal dot at the furthest tip.
  // Lifecycle-safe under the ClientRouter. KEEP THE GROWTH MATH IN SYNC with
  // buildRoots in src/lib/process.js.
  const DRAW_MS = 5600;
  const reducedMq = window.matchMedia('(prefers-reduced-motion: reduce)');
  let reduced = reducedMq.matches;
  let canvas: HTMLCanvasElement | null = null;
  let ctx: CanvasRenderingContext2D | null = null;
  let raf = 0, running = false;
  let art: any = null; // { iters, far, ticks, w, h, drawn, elapsed }

  function xmur3(str: string) {
    let h = 1779033703 ^ str.length;
    for (let i = 0; i < str.length; i++) {
      h = Math.imul(h ^ str.charCodeAt(i), 3432918353);
      h = (h << 13) | (h >>> 19);
    }
    return () => {
      h = Math.imul(h ^ (h >>> 16), 2246822507);
      h = Math.imul(h ^ (h >>> 13), 3266489909);
      return (h ^= h >>> 16) >>> 0;
    };
  }
  function mulberry32(a: number) {
    return () => {
      a |= 0; a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function makeNoise(seedInt: number) {
    const lattice = (ix: number, iy: number) => {
      let h = Math.imul(ix, 374761393) + Math.imul(iy, 668265263) + Math.imul(seedInt, 2246822519);
      h = Math.imul(h ^ (h >>> 13), 1274126177);
      return (((h ^ (h >>> 16)) >>> 0) % 100000) / 100000;
    };
    const sm = (t: number) => t * t * (3 - 2 * t);
    return (x: number, y: number) => {
      const ix = Math.floor(x), iy = Math.floor(y);
      const fx = sm(x - ix), fy = sm(y - iy);
      const a = lattice(ix, iy), b = lattice(ix + 1, iy);
      const c = lattice(ix, iy + 1), d = lattice(ix + 1, iy + 1);
      return a + (b - a) * fx + (c + (d - c) * fx - (a + (b - a) * fx)) * fy;
    };
  }

  function colors() {
    const s = getComputedStyle(document.documentElement);
    return {
      ink: s.getPropertyValue('--ink').trim() || '#333',
      muted: s.getPropertyValue('--muted').trim() || '#666',
      sig: s.getPropertyValue('--sig').trim() || '#1a7f37',
      dark: document.documentElement.getAttribute('data-theme') === 'dark',
    };
  }

  function build(keepSeed = false) {
    if (!canvas || !ctx) return;
    const params = new URLSearchParams(location.search);
    let seedInt: number;
    if (keepSeed && art) seedInt = art.seedInt;
    else if (params.get('seed')) seedInt = parseInt(params.get('seed')!, 16) | 0;
    else seedInt = (Math.random() * 2 ** 31) | 0;
    const label = document.getElementById('seed-label');
    if (label) label.textContent = (seedInt >>> 0).toString(16).padStart(8, '0').slice(0, 6);

    const w = canvas.clientWidth || 575, h = canvas.clientHeight || 136;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const counts = [...(canvas.dataset.counts || '')].map((c) => parseInt(c, 36));
    const n = counts.length || 1;
    const raw = counts.map((c) => Math.log1p(c));
    const sortedRaw = raw.slice().sort((a, b) => a - b);
    const p95 = Math.max(sortedRaw[Math.floor(sortedRaw.length * 0.95)] || 0, 0.001);
    const env = raw.map((_, i) => {
      let s = 0, wt = 0;
      for (let k = -4; k <= 4; k++) {
        const j = i + k;
        if (j < 0 || j >= n) continue;
        const g = 1 - Math.abs(k) / 5;
        s += raw[j] * g; wt += g;
      }
      return Math.min(1.25, s / wt / p95);
    });
    const envAt = (t: number) => env[Math.max(0, Math.min(n - 1, Math.floor(t * n)))];

    const rand = mulberry32(seedInt);
    const noise = makeNoise(seedInt);
    const STEP = 1.7, CAP = 190;
    type Tip = { x: number; y: number; a: number; wd: number; born: number; alive: boolean };
    const tips: Tip[] = [];
    for (let i = 0; i < 6; i++) {
      tips.push({ x: -2, y: h * 0.15 + rand() * h * 0.7, a: 0, wd: 1.5, born: i * 14, alive: true });
    }
    let total = tips.length;
    let far = { x: 0, y: h / 2 };
    const iters: number[][][] = [];
    for (let it = 0; it < 700; it++) {
      const segs: number[][] = [];
      let anyAlive = false;
      const spawned: Tip[] = [];
      for (const t of tips) {
        if (!t.alive || t.born > it) { if (t.alive) anyAlive = true; continue; }
        anyAlive = true;
        const e = envAt(t.x / w);
        t.a += (noise(t.x * 0.012, t.y * 0.02) - 0.5) * (0.35 + e * 0.55);
        t.a = Math.max(-0.62, Math.min(0.62, t.a));
        const nx = t.x + Math.cos(t.a) * STEP, ny = t.y + Math.sin(t.a) * STEP;
        segs.push([t.x, t.y, nx, ny, t.wd]);
        t.x = nx; t.y = ny;
        if (t.x > far.x) far = { x: t.x, y: t.y };
        if (t.x > w - 3) { t.alive = false; continue; }
        if (t.y < 3 || t.y > h - 3) { t.y = Math.max(3, Math.min(h - 3, t.y)); t.a = -t.a * 0.7; }
        if (total < CAP && rand() < 0.013 + e * 0.06 * rand()) {
          spawned.push({ x: t.x, y: t.y, a: t.a + (rand() < 0.5 ? -1 : 1) * (0.3 + rand() * 0.35), wd: Math.max(0.6, t.wd * 0.8), born: it + 1, alive: true });
          total++;
        }
      }
      tips.push(...spawned);
      iters.push(segs);
      if (!anyAlive) break;
    }
    art = { seedInt, iters, far: { x: Math.min(far.x, w - 4), y: far.y }, w, h, drawn: 0, elapsed: 0 };
  }

  function scaffold() {
    if (!ctx || !art) return;
    ctx.clearRect(0, 0, art.w, art.h);
  }

  function growth(from: number, to: number) {
    if (!ctx || !art) return;
    const c = colors();
    ctx.strokeStyle = c.ink;
    ctx.lineCap = 'round';
    for (let it = from; it < to; it++) {
      for (const [x1, y1, x2, y2, wd] of art.iters[it]) {
        ctx.globalAlpha = 0.26 + Math.min(0.26, wd * 0.13);
        ctx.lineWidth = wd;
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
      }
    }
    ctx.globalAlpha = 1;
    ctx.lineWidth = 1;
  }

  function dot() {
    if (!ctx || !art) return;
    const c = colors();
    if (c.dark) {
      ctx.fillStyle = c.sig;
      ctx.globalAlpha = 0.22;
      ctx.beginPath();
      ctx.arc(art.far.x, art.far.y, 7, 0, Math.PI * 2);
      ctx.fill();
      ctx.globalAlpha = 1;
    }
    ctx.fillStyle = c.sig;
    ctx.beginPath();
    ctx.arc(art.far.x, art.far.y, 3, 0, Math.PI * 2);
    ctx.fill();
  }

  const ease = (t: number) => (t < 0 ? 0 : t > 1 ? 1 : t * t * (3 - 2 * t));

  function pause() { running = false; cancelAnimationFrame(raf); }

  function renderSettled(keepSeed = true) {
    if (!canvas) return;
    pause(); build(keepSeed); scaffold();
    growth(0, art.iters.length);
    art.drawn = art.iters.length;
    art.elapsed = DRAW_MS;
    dot();
  }

  function runLoop() {
    if (running || !art) return;
    running = true;
    let last = performance.now();
    const loop = (now: number) => {
      if (!running || !art) return;
      const dt = Math.min(now - last, 100);
      last = now;
      art.elapsed += dt;
      const target = Math.min(art.iters.length, Math.round(ease(art.elapsed / DRAW_MS) * art.iters.length));
      if (target > art.drawn) { growth(art.drawn, target); art.drawn = target; }
      if (art.drawn >= art.iters.length) { dot(); running = false; return; }
      raf = requestAnimationFrame(loop);
    };
    raf = requestAnimationFrame(loop);
  }

  function start() {
    pause(); build();
    if (!art) return;
    scaffold();
    if (reduced) { renderSettled(); return; }
    runLoop();
  }

  function teardown() {
    pause();
    art = null;
    canvas = null;
    ctx = null;
  }

  function init() {
    const el = document.getElementById('field') as HTMLCanvasElement | null;
    if (!el) { teardown(); return; }
    if (el === canvas && art) return;
    canvas = el;
    ctx = el.getContext('2d');
    start();
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', teardown);
  document.addEventListener('visibilitychange', () => {
    if (!art) return;
    if (document.hidden) pause();
    else if (art.drawn < art.iters.length && !reduced) runLoop();
  });
  new MutationObserver(() => { if (art) renderSettled(); })
    .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  let rt: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(rt);
    rt = setTimeout(() => { if (canvas && art && canvas.clientWidth !== art.w) renderSettled(false); }, 200);
  });
  reducedMq.addEventListener('change', (e) => {
    reduced = e.matches;
    if (reduced && art) renderSettled();
  });
  init();
</script>

<style>
  h1 {
    margin-bottom: 2rem;
  }

  .instrument {
    margin-bottom: 3.2rem;
  }
  .instrument canvas {
    display: block;
    width: 100%;
    height: 136px;
    border: 1px solid var(--hairline);
  }
  .instrument :global(noscript svg) {
    border: 1px solid var(--hairline);
  }
  .instrument figcaption {
    font-family: 'Berkeley Mono', monospace;
    font-size: 1.15rem;
    color: var(--muted);
    text-align: right;
    margin-top: 0.7rem;
    letter-spacing: 0.02em;
  }

  .facts {
    list-style: disc;
    padding-left: 2rem;
    font-size: 1.7rem;
    line-height: 1.65;
    color: var(--ink);
    margin-bottom: 4rem;
  }

  .facts li {
    margin-bottom: 0.7rem;
  }

  .facts a {
    text-decoration: underline;
    text-decoration-color: var(--muted);
    text-underline-offset: 0.2em;
  }

  .facts a:hover {
    text-decoration-color: var(--ink-strong);
  }

  .writing-section {
    margin-bottom: 4rem;
  }

  .rows {
    list-style: none;
    padding: 0;
  }
</style>
