---
// THROWAWAY LAB — three candidate instruments, random seed per load. Not linked; delete after the pick.
import contributions from '../../public/data/contributions.json';

const days = (contributions as { date: string; count: number }[])
  .slice()
  .sort((a, b) => a.date.localeCompare(b.date));
const countsB36 = days.map((d) => Math.min(35, d.count).toString(36)).join('');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>instrument lab</title>
    <meta name="robots" content="noindex" />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', stored || (prefersDark ? 'dark' : 'light'));
      })();
    </script>
  </head>
  <body data-counts={countsB36}>
    <main>
      <section><h2>A · weather — sparse streamlines, storms where the work was</h2><canvas id="a" height="136"></canvas></section>
      <section><h2>B · organism — slime-mold veins, fed by the heavy weeks</h2><canvas id="b" height="136"></canvas></section>
      <section><h2>C · rootwork — branching growth, ramifying where it was busy</h2><canvas id="c" height="136"></canvas></section>
      <button id="again">draw again (new seed)</button>
    </main>

    <script>
      const counts = [...(document.body.dataset.counts || '')].map((ch) => parseInt(ch, 36));
      const n = counts.length;
      const raw = counts.map((c) => Math.log1p(c));
      const sortedRaw = raw.slice().sort((x, y) => x - y);
      const p95 = Math.max(sortedRaw[Math.floor(sortedRaw.length * 0.95)] || 0, 0.001);
      const envArr = raw.map((_, i) => {
        let s = 0, wt = 0;
        for (let k = -4; k <= 4; k++) {
          const j = i + k;
          if (j < 0 || j >= n) continue;
          const g = 1 - Math.abs(k) / 5;
          s += raw[j] * g; wt += g;
        }
        return Math.min(1.25, s / wt / p95);
      });
      const envAt = (t: number) => envArr[Math.max(0, Math.min(n - 1, Math.floor(t * n)))];

      function mulberry32(a: number) {
        return () => {
          a |= 0; a = (a + 0x6d2b79f5) | 0;
          let t = Math.imul(a ^ (a >>> 15), 1 | a);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }
      function makeNoise(seedInt: number) {
        const lattice = (ix: number, iy: number) => {
          let h = Math.imul(ix, 374761393) + Math.imul(iy, 668265263) + Math.imul(seedInt, 2246822519);
          h = Math.imul(h ^ (h >>> 13), 1274126177);
          return (((h ^ (h >>> 16)) >>> 0) % 100000) / 100000;
        };
        const sm = (t: number) => t * t * (3 - 2 * t);
        return (x: number, y: number) => {
          const ix = Math.floor(x), iy = Math.floor(y);
          const fx = sm(x - ix), fy = sm(y - iy);
          const a = lattice(ix, iy), b = lattice(ix + 1, iy);
          const c = lattice(ix, iy + 1), d = lattice(ix + 1, iy + 1);
          return a + (b - a) * fx + (c + (d - c) * fx - (a + (b - a) * fx)) * fy;
        };
      }

      function setup(id: string) {
        const cv = document.getElementById(id) as HTMLCanvasElement;
        const ctx = cv.getContext('2d')!;
        const w = cv.clientWidth, h = cv.clientHeight;
        const dpr = Math.min(devicePixelRatio || 1, 2);
        cv.width = w * dpr; cv.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);
        const st = getComputedStyle(document.documentElement);
        return {
          cv, ctx, w, h,
          ink: st.getPropertyValue('--ink').trim(),
          sig: st.getPropertyValue('--sig').trim(),
          dark: document.documentElement.getAttribute('data-theme') === 'dark',
        };
      }

      // A · WEATHER — sparse streamlines; turbulence and ink cluster where env is high
      function weather(seedInt: number) {
        const { ctx, w, h, ink, sig } = setup('a');
        const rand = mulberry32(seedInt);
        const noise = makeNoise(seedInt);
        ctx.lineWidth = 1;
        const LINES = 46;
        for (let s = 0; s < LINES; s++) {
          let x = rand() * w * 0.25 - 6;
          let y = h * 0.08 + rand() * h * 0.84;
          const personal = rand() * 6;
          ctx.strokeStyle = ink;
          ctx.globalAlpha = 0.34 + rand() * 0.22;
          ctx.beginPath();
          ctx.moveTo(x, y);
          for (let i = 0; i < 340; i++) {
            const e = envAt(x / w);
            const a = (noise(x * 0.008, y * 0.014 + personal) - 0.5) * Math.PI * (0.5 + e * 1.6);
            x += Math.cos(a) * 1.7 + 0.9;
            y += Math.sin(a) * 1.7 * (0.5 + e * 0.7);
            if (x > w + 4 || y < -4 || y > h + 4) break;
            ctx.lineTo(x, y);
          }
          ctx.stroke();
        }
        // one signal streamline through the storm's heart
        let mi = 0; envArr.forEach((e, i) => { if (e > envArr[mi]) mi = i; });
        let x = (mi / n) * w - 60, y = h * 0.5;
        ctx.strokeStyle = sig; ctx.globalAlpha = 0.9; ctx.lineWidth = 1.4;
        ctx.beginPath(); ctx.moveTo(x, y);
        for (let i = 0; i < 130; i++) {
          const e = envAt(x / w);
          const a = (noise(x * 0.008, y * 0.014 + 3.3) - 0.5) * Math.PI * (0.5 + e * 1.6);
          x += Math.cos(a) * 1.7 + 0.9; y += Math.sin(a) * 1.7 * (0.5 + e * 0.7);
          ctx.lineTo(x, y);
        }
        ctx.stroke(); ctx.globalAlpha = 1; ctx.lineWidth = 1;
      }

      // B · ORGANISM — physarum-style trails; agents seeded by the data's weight
      function organism(seedInt: number) {
        const { ctx, w, h, ink, sig, dark } = setup('b');
        const rand = mulberry32(seedInt);
        const N = 4200, STEPS = 260;
        const trail = new Float32Array(w * h);
        const ags: number[] = [];
        for (let i = 0; i < N; i++) {
          // seed agents along x weighted by env, so the colony lives where the work was
          let t = rand(); let guard = 0;
          while (envAt(t) < rand() * 1.1 && guard++ < 8) t = rand();
          ags.push(t * w, h * 0.15 + rand() * h * 0.7, rand() * Math.PI * 2);
        }
        const sense = (x: number, y: number, a: number) => {
          const sx = Math.round(x + Math.cos(a) * 7), sy = Math.round(y + Math.sin(a) * 7);
          if (sx < 0 || sx >= w || sy < 0 || sy >= h) return -1;
          return trail[sy * w + sx];
        };
        for (let s = 0; s < STEPS; s++) {
          for (let i = 0; i < N; i++) {
            const ix = i * 3;
            let [x, y, a] = [ags[ix], ags[ix + 1], ags[ix + 2]];
            const F = sense(x, y, a), L = sense(x, y, a - 0.5), R = sense(x, y, a + 0.5);
            if (L > F && L > R) a -= 0.4;
            else if (R > F && R > L) a += 0.4;
            else if (rand() < 0.05) a += (rand() - 0.5) * 0.5;
            x += Math.cos(a) * 1.2; y += Math.sin(a) * 1.2;
            if (x < 2) { x = 2; a = Math.PI - a; }
            if (x > w - 2) { x = w - 2; a = Math.PI - a; }
            if (y < 2) { y = 2; a = -a; }
            if (y > h - 2) { y = h - 2; a = -a; }
            const px = (Math.round(y) * w + Math.round(x));
            trail[px] += 0.5 + envAt(x / w) * 0.55;
            ags[ix] = x; ags[ix + 1] = y; ags[ix + 2] = a;
          }
          if (s % 2 === 0) for (let p = 0; p < trail.length; p++) trail[p] *= 0.955;
        }
        // one 3x3 blur pass so trails fuse into veins
        const blurred = new Float32Array(trail.length);
        for (let y = 1; y < h - 1; y++)
          for (let x = 1; x < w - 1; x++) {
            let acc = 0;
            for (let dy = -1; dy <= 1; dy++)
              for (let dx = -1; dx <= 1; dx++) acc += trail[(y + dy) * w + (x + dx)];
            blurred[y * w + x] = acc / 9;
          }
        trail.set(blurred);
        let mx = 0;
        for (let p = 0; p < trail.length; p++) if (trail[p] > mx) mx = trail[p];
        const img = ctx.createImageData(w, h);
        const [ir, ig, ib] = dark ? [200, 200, 200] : [26, 26, 26];
        for (let p = 0; p < trail.length; p++) {
          const v = Math.pow(trail[p] / mx, 0.65);
          if (v < 0.1) continue;
          const o = p * 4;
          img.data[o] = ir; img.data[o + 1] = ig; img.data[o + 2] = ib;
          img.data[o + 3] = Math.min(235, v * 255);
        }
        ctx.putImageData(img, 0, 0);
        // the colony's brightest node, marked
        let pi = 0; for (let p = 0; p < trail.length; p++) if (trail[p] > trail[pi]) pi = p;
        ctx.fillStyle = sig;
        ctx.beginPath(); ctx.arc(pi % w, Math.floor(pi / w), 3, 0, Math.PI * 2); ctx.fill();
      }

      // C · ROOTWORK — branching growth left→right; ramifies where env is high
      function rootwork(seedInt: number) {
        const { ctx, w, h, ink, sig } = setup('c');
        const rand = mulberry32(seedInt);
        const noise = makeNoise(seedInt);
        ctx.lineWidth = 1;
        type Tip = { x: number; y: number; a: number; wd: number };
        let tips: Tip[] = [];
        for (let i = 0; i < 6; i++) tips.push({ x: -2, y: h * 0.15 + rand() * h * 0.7, a: 0, wd: 1.5 });
        let total = tips.length;
        let far: Tip = tips[0];
        ctx.strokeStyle = ink;
        while (tips.length) {
          const next: Tip[] = [];
          for (const t of tips) {
            const e = envAt(t.x / w);
            t.a += (noise(t.x * 0.012, t.y * 0.02) - 0.5) * (0.35 + e * 0.55);
            t.a = Math.max(-0.62, Math.min(0.62, t.a));
            const nx = t.x + Math.cos(t.a) * 2.0, ny = t.y + Math.sin(t.a) * 2.0;
            ctx.globalAlpha = 0.3 + Math.min(0.3, t.wd * 0.15);
            ctx.lineWidth = t.wd;
            ctx.beginPath(); ctx.moveTo(t.x, t.y); ctx.lineTo(nx, ny); ctx.stroke();
            t.x = nx; t.y = ny;
            if (t.x > far.x) far = t;
            if (t.x > w - 3) continue;
            if (t.y < 3 || t.y > h - 3) { t.y = Math.max(3, Math.min(h - 3, t.y)); t.a = -t.a * 0.7; }
            if (total < 220 && rand() < 0.013 + e * 0.06 * rand()) {
              next.push({ x: t.x, y: t.y, a: t.a + (rand() < 0.5 ? -1 : 1) * (0.3 + rand() * 0.35), wd: Math.max(0.6, t.wd * 0.8) });
              total++;
            }
            next.push(t);
          }
          tips = next;
          if (total > 4000) break;
        }
        ctx.globalAlpha = 1; ctx.lineWidth = 1;
        ctx.fillStyle = sig;
        ctx.beginPath(); ctx.arc(Math.min(far.x, w - 4), far.y, 3, 0, Math.PI * 2); ctx.fill();
      }

      function drawAll() {
        const seed = (Math.random() * 2 ** 31) | 0;
        weather(seed);
        organism(seed ^ 0x9e3779b9);
        rootwork(seed ^ 0x85ebca6b);
      }
      document.getElementById('again')!.addEventListener('click', drawAll);
      drawAll();
    </script>

    <style is:global>
      :root { --paper: #fff; --ink: #333; --muted: #666; --hairline: #e6e6e6; --sig: #1a7f37; }
      [data-theme='dark'] { --paper: #0a0a0a; --ink: #c8c8c8; --muted: #8a8a8a; --hairline: #222; --sig: #53d339; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: var(--paper); color: var(--ink); font-family: ui-monospace, monospace; }
      main { max-width: 575px; margin: 3rem auto; padding: 0 1rem; }
      section { margin-bottom: 2.2rem; }
      h2 { font-size: 11px; font-weight: 400; color: var(--muted); margin-bottom: 6px; letter-spacing: 0.05em; }
      canvas { display: block; width: 100%; height: 136px; border: 1px solid var(--hairline); }
      button { font: inherit; font-size: 12px; color: var(--muted); background: none; border: 1px solid var(--hairline); padding: 6px 12px; cursor: pointer; }
    </style>
  </body>
</html>
