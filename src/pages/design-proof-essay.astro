---
// DESIGN PROOF — essay page under direction "Process". Standalone, does not touch the app.
// The slug's glyph appears as a pressmark by the byline and as the end-mark. No hero image.
import { getEntry, render } from 'astro:content';
import Logo from '../components/Logo.astro';

const entry = await getEntry('writing', 'the-agentic-web');
if (!entry) throw new Error('proof essay not found');
const { Content } = await render(entry);

const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });

// same deterministic glyph generator as the homepage proof
function xmur3(str: string) {
  let h = 1779033703 ^ str.length;
  for (let i = 0; i < str.length; i++) {
    h = Math.imul(h ^ str.charCodeAt(i), 3432918353);
    h = (h << 13) | (h >>> 19);
  }
  return () => {
    h = Math.imul(h ^ (h >>> 16), 2246822507);
    h = Math.imul(h ^ (h >>> 13), 3266489909);
    return (h ^= h >>> 16) >>> 0;
  };
}
function mulberry32(a: number) {
  return () => {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function makeNoise(seedInt: number) {
  const lattice = (ix: number, iy: number) => {
    let h = Math.imul(ix, 374761393) + Math.imul(iy, 668265263) + Math.imul(seedInt, 2246822519);
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return (((h ^ (h >>> 16)) >>> 0) % 100000) / 100000;
  };
  const smooth = (t: number) => t * t * (3 - 2 * t);
  return (x: number, y: number) => {
    const ix = Math.floor(x), iy = Math.floor(y);
    const fx = smooth(x - ix), fy = smooth(y - iy);
    const a = lattice(ix, iy), b = lattice(ix + 1, iy);
    const c = lattice(ix, iy + 1), d = lattice(ix + 1, iy + 1);
    return a + (b - a) * fx + (c + (d - c) * fx - (a + (b - a) * fx)) * fy;
  };
}
function glyphPath(slug: string): string {
  const seedInt = xmur3(slug)();
  const rand = mulberry32(seedInt);
  const noise = makeNoise(seedInt);
  const freq = 0.055 + rand() * 0.05;
  const turb = 1.7 + rand() * 1.1;
  const S = 40, STEPS = 84;
  let best: { pts: [number, number][]; span: number } = { pts: [], span: 0 };
  for (let c = 0; c < 8; c++) {
    let x = 6 + rand() * (S - 12), y = 6 + rand() * (S - 12);
    const pts: [number, number][] = [[x, y]];
    let minX = x, maxX = x, minY = y, maxY = y;
    for (let i = 0; i < STEPS; i++) {
      const a = (noise(x * freq, y * freq) - 0.5) * Math.PI * 2 * turb;
      x += Math.cos(a) * 0.85;
      y += Math.sin(a) * 0.85;
      if (x < 1 || x > S - 1 || y < 1 || y > S - 1) break;
      pts.push([x, y]);
      minX = Math.min(minX, x); maxX = Math.max(maxX, x);
      minY = Math.min(minY, y); maxY = Math.max(maxY, y);
    }
    const span = (maxX - minX) * (maxY - minY) + pts.length;
    if (span > best.span) best = { pts, span };
  }
  const pts = best.pts;
  if (pts.length < 4) return 'M6 12 L18 12';
  let minX = 1e9, maxX = -1e9, minY = 1e9, maxY = -1e9;
  for (const [px, py] of pts) {
    minX = Math.min(minX, px); maxX = Math.max(maxX, px);
    minY = Math.min(minY, py); maxY = Math.max(maxY, py);
  }
  const scale = 18 / Math.max(maxX - minX, maxY - minY, 1);
  const ox = 3 + (18 - (maxX - minX) * scale) / 2, oy = 3 + (18 - (maxY - minY) * scale) / 2;
  return pts
    .map(([px, py], i) =>
      `${i === 0 ? 'M' : 'L'}${((px - minX) * scale + ox).toFixed(1)} ${((py - minY) * scale + oy).toFixed(1)}`)
    .join('');
}
const glyph = glyphPath(entry.id);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Design proof — essay page</title>
    <meta name="robots" content="noindex" />
    <link rel="preload" href="/fonts/source-serif/ss4-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif/ss4-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', stored || (prefersDark ? 'dark' : 'light'));
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="logo" href="/design-proof" aria-label="Home"><Logo /></a>
      <nav aria-label="Main">
        <a href="/writing">writing</a>
        <a href="/talks">talks</a>
        <a href="/projects">projects</a>
        <button id="theme-toggle" aria-label="Toggle theme">◐</button>
      </nav>
    </header>

    <main class="container">
      <article>
        <header class="essay-header">
          <h1>{entry.data.title}</h1>
          <p class="byline">
            <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true"><path d={glyph} /></svg>
            <time datetime={entry.data.date}>{fmtDate(entry.data.date)}</time>
          </p>
        </header>
        <div class="essay-body">
          <Content />
        </div>
        <footer class="end-mark" aria-hidden="true">
          <svg class="glyph glyph-end" viewBox="0 0 24 24"><path d={glyph} /></svg>
        </footer>
      </article>
    </main>

    <footer class="site-footer">
      <a href="https://www.linkedin.com/in/johnmilinovich/">linkedin</a><span>·</span>
      <a href="https://x.com/jmilinovich">x</a><span>·</span>
      <a href="https://github.com/jmilinovich">github</a><span>·</span>
      <a href="/rss.xml">rss</a>
    </footer>

    <script>
      document.getElementById('theme-toggle')!.addEventListener('click', () => {
        const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    </script>

    <style is:global>
      :root {
        --paper: #fff;
        --ink: #333;
        --ink-strong: #111;
        --muted: #666;
        --hairline: #e6e6e6;
        --code-bg: #f5f5f5;
        --sig: #1a7f37;
        --glyph: rgba(26, 26, 26, 0.85);
      }
      [data-theme='dark'] {
        --paper: #0a0a0a;
        --ink: #c8c8c8;
        --ink-strong: #e8e8e8;
        --muted: #8a8a8a;
        --hairline: #222;
        --code-bg: #1a1a1a;
        --sig: #53d339;
        --glyph: #53d339;
      }

      @font-face {
        font-family: 'Source Serif 4';
        src: url('/fonts/source-serif/ss4-latin-400-normal.woff2') format('woff2');
        font-weight: 400; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'Source Serif 4';
        src: url('/fonts/source-serif/ss4-latin-600-normal.woff2') format('woff2');
        font-weight: 600; font-style: normal; font-display: swap;
      }
      @font-face {
        font-family: 'Source Serif 4';
        src: url('/fonts/source-serif/ss4-latin-400-italic.woff2') format('woff2');
        font-weight: 400; font-style: italic; font-display: swap;
      }
      @font-face {
        font-family: 'Berkeley Mono';
        src: url('/fonts/BerkeleyMono-Regular.otf') format('opentype');
        font-weight: 400; font-style: normal; font-display: swap;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-size: 62.5%; scrollbar-gutter: stable; }
      body {
        font-family: 'Source Serif 4', Georgia, serif;
        font-size: 1.7rem;
        line-height: 1.7;
        color: var(--ink);
        background: var(--paper);
        -webkit-font-smoothing: antialiased;
      }
      ::selection { background: var(--sig); color: var(--paper); }
      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--sig); outline-offset: 3px; border-radius: 1px; }

      .site-header {
        max-width: 575px; margin: 0 auto; padding: 3rem 2rem 2.4rem;
        display: flex; align-items: center; justify-content: space-between;
      }
      nav { display: flex; gap: 1.8rem; align-items: baseline; }
      nav a, #theme-toggle {
        font-family: 'Berkeley Mono', monospace; font-size: 1.3rem; color: var(--muted);
        text-decoration: none;
      }
      nav a:hover { color: var(--ink-strong); }
      #theme-toggle { background: none; border: none; cursor: pointer; font-size: 1.4rem; }
      .logo { display: flex; align-items: center; color: var(--ink-strong); }
      .logo:hover { opacity: 0.7; }
      .logo .logo-container { width: 42px; height: 28px; }

      .container { max-width: 575px; margin: 0 auto; padding: 0 2rem 6rem; }

      .essay-header { margin-bottom: 3.6rem; }
      .essay-header h1 {
        font-weight: 600;
        font-size: clamp(2.8rem, 2.1rem + 1.4vw, 3.8rem);
        letter-spacing: -0.015em;
        line-height: 1.15;
        color: var(--ink-strong);
        margin-bottom: 1.4rem;
      }
      .byline {
        display: flex; align-items: center; gap: 1rem;
        font-family: 'Berkeley Mono', monospace; font-size: 1.25rem; color: var(--muted);
      }
      .glyph { width: 20px; height: 20px; overflow: visible; }
      .glyph path {
        fill: none; stroke: var(--glyph); stroke-width: 1.7;
        stroke-linecap: round; stroke-linejoin: round;
      }

      .essay-body > * + * { margin-top: 2rem; }
      .essay-body h2 { font-size: 2.3rem; font-weight: 600; color: var(--ink-strong); margin-top: 4rem; line-height: 1.25; }
      .essay-body h3 { font-size: 1.9rem; font-weight: 600; color: var(--ink-strong); margin-top: 3.2rem; }
      .essay-body a { text-decoration: underline; text-decoration-color: var(--hairline); text-underline-offset: 0.2em; }
      .essay-body a:hover { text-decoration-color: var(--sig); }
      .essay-body strong { color: var(--ink-strong); }
      .essay-body em { font-style: italic; }
      .essay-body ul, .essay-body ol { padding-left: 2.4rem; }
      .essay-body li { margin-top: 0.6rem; }
      .essay-body blockquote {
        border-left: 2px solid var(--hairline);
        padding-left: 1.8rem; color: var(--muted); font-style: italic;
      }
      .essay-body code {
        font-family: 'Berkeley Mono', monospace; font-size: 1.35rem;
        background: var(--code-bg); padding: 0.2rem 0.5rem;
      }
      .essay-body pre { background: var(--code-bg); padding: 1.6rem; overflow-x: auto; }
      .essay-body pre code { background: none; padding: 0; }
      .essay-body img { max-width: 100%; height: auto; border: 1px solid var(--hairline); }
      .essay-body hr { border: none; border-top: 1px solid var(--hairline); margin: 3.2rem 0; }

      .end-mark { display: flex; justify-content: center; margin-top: 5rem; }
      .glyph-end { width: 28px; height: 28px; }

      .site-footer {
        max-width: 575px; margin: 0 auto; padding: 0 2rem 5rem;
        display: flex; justify-content: center; gap: 1rem;
        font-family: 'Berkeley Mono', monospace; font-size: 1.25rem; color: var(--muted);
      }
      .site-footer a { text-decoration: none; }
      .site-footer span { color: var(--hairline); }
      .site-footer a:hover { color: var(--ink-strong); }
    </style>
  </body>
</html>
